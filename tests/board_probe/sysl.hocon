// A board's package: it takes cstd as its C library, as a board does, and its C supplies what the
// board has: a strong `write` to the debug console and `_Exit`/`_exit` through semihosting
// (`board.c`), and `sbrk` over a static array (`board_heap.c`, linked only where the program calls
// `board_heap_init`). cstd's own definitions are weak defaults, so the link keeps these; every other
// call stays cstd's default.
// `sh/sysl/cstd/stubs_tests.sysl` builds it for a Cortex-M and runs it under QEMU.

package {
  name    = "cstd_board_probe"
  version = "0.0.1"
}

dependencies {
  cstd { path = "../..", if = "!libc" }
}

c {
  board {
    root    = "c"
    sources = ["board.c", "board_heap.c"]
  }
}
