module sh.sysl.cstd_linux

// How a process ends: `exit` runs what `atexit` registered, last first, and then ends every thread
// with `exit_group`; `_exit` and `_Exit` skip the handlers; `abort` sends the process SIGABRT. The
// handler table is the portable half's (`sh/sysl/cstd/exit.sysl`).

import sh.sysl.cstd.{atexit_register, run_atexit_handlers}

@export("atexit")
atexit(f: *extern() -> unit) -> i32 = atexit_register(f)

@export("exit")
exit(status: i32) -> never
    run_atexit_handlers()
    _exit(status)

@export("_exit")
_exit(status: i32) -> never
    loop
        svc(SYS_EXIT_GROUP, u64(status), 0, 0, 0, 0, 0)

@export("_Exit")
c_Exit(status: i32) -> never = _exit(status)

// POSIX has `abort` override SIGABRT being blocked or ignored: it is unblocked and sent; if the
// process comes back — it was ignored, or caught by a handler that returned — its action is put back
// to the default and it is sent again. Should even that come back, the process ends with the status
// a shell reports for SIGABRT.
const SIGABRT: u64 = 6
const SIG_UNBLOCK: u64 = 1

@export("abort")
abort() -> never
    var abrt: u64 = 1 << (SIGABRT - 1)
    call(SYS_RT_SIGPROCMASK, SIG_UNBLOCK, u64(usize(&abrt)), 0, 8)
    val me = u64(call(SYS_GETPID))
    call(SYS_KILL, me, SIGABRT)
    // The kernel's `struct sigaction` on arm64 — handler, flags, restorer, mask — all zero: SIG_DFL.
    var default_action: [4]u64 = [0, 0, 0, 0]
    call(SYS_RT_SIGACTION, SIGABRT, u64(usize(&default_action[0])), 0, 8)
    call(SYS_KILL, me, SIGABRT)
    _exit(128 + 6)
