module sh.sysl.cstd_linux

// `brk`, `sbrk`, and `malloc` and its family over them: the portable half's `BreakHeap` is the
// allocator, and this file gives it the kernel's break. One heap for the whole process, and no lock
// around it; `pthread` support has to add one.

import sh.sysl.cstd.{BreakHeap, ENOMEM, Heap, errno}

// The break as the kernel last answered it; 0 until the first `brk`/`sbrk`.
private var current_break: usize = 0

// Linux's `brk` answers the new break, or the old one where it could not move.
private kernel_brk(to: usize) -> usize = usize(call(SYS_BRK, u64(to)))

@export("brk")
brk(to: *u8) -> i32
    val now = kernel_brk(usize(to))
    current_break = now
    if now != usize(to)
        errno = ENOMEM
        return -1
    0

@export("sbrk")
sbrk(by: isize) -> *u8
    if current_break == 0 then current_break = kernel_brk(0)
    val old = current_break
    if by == 0 then return ptr_cast(old)
    val want = usize(isize(old) + by)
    val now = kernel_brk(want)
    current_break = now
    if now != want
        errno = ENOMEM
        return ptr_cast(usize::Max)
    ptr_cast(old)

// The break moves at least 64 KiB each time the heap grows, so a run of small requests is not a
// system call each.
private var heap: BreakHeap = BreakHeap(Heap(0, 0, 0), 64 * 1024)

@export("malloc")
malloc(n: usize) -> *u8 = heap.malloc(n)

@export("free")
free(p: *u8) = heap.free(p)

@export("calloc")
calloc(count: usize, size: usize) -> *u8 = heap.calloc(count, size)

@export("realloc")
realloc(p: *u8, n: usize) -> *u8 = heap.realloc(p, n)
