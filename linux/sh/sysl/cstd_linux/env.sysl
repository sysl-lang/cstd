module sh.sysl.cstd_linux

// `getenv`, over `environ`: the zero-ended vector of `NAME=value` strings `crt0` points at the
// kernel's. It is in this half because `environ` is: a machine with no process has no environment.

// The value after `NAME=` of the first entry whose name is exactly `name`, or null. A name that is
// empty or holds `=` can match no entry, and is null without looking.
@export("getenv")
getenv(name: *u8) -> *u8
    if name[0] == 0 then return null
    var n: usize = 0
    loop
        if name[n] == 0 then break
        if name[n] == u8('=') then return null
        n += 1
    if environ == null then return null
    var e: usize = 0
    loop
        val entry = environ[e]
        if entry == null then return null
        var i: usize = 0
        loop
            if i == n || entry[i] != name[i] then break
            i += 1
        if i == n && entry[n] == u8('=') then return &entry[n + 1]
        e += 1
