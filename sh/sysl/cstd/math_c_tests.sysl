@test("where long double is a double, each l function is its double counterpart to the bit")
math_long_double()
    c_case(raw"""
        double xs[] = {0.3, -1.7, 2.5, 100.25, 1e-310};
        int same = 1;
        for (int i = 0; i < 5; i++) {
            double x = xs[i];
            same &= sinl(x) == sin(x) && cosl(x) == cos(x) && tanl(x) == tan(x) && expl(x) == exp(x);
            same &= exp2l(x) == exp2(x) && expm1l(x) == expm1(x) && atanl(x) == atan(x);
            same &= sinhl(x) == sinh(x) && coshl(x) == cosh(x) && tanhl(x) == tanh(x) && asinhl(x) == asinh(x);
            same &= cbrtl(x) == cbrt(x) && erfl(x) == erf(x) && erfcl(x) == erfc(x) && tgammal(x) == tgamma(x);
            same &= floorl(x) == floor(x) && ceill(x) == ceil(x) && roundl(x) == round(x) && truncl(x) == trunc(x);
            same &= rintl(x) == rint(x) && nearbyintl(x) == nearbyint(x) && lrintl(x) == lrint(x);
            same &= llrintl(x) == llrint(x) && lroundl(x) == lround(x) && llroundl(x) == llround(x);
            same &= powl(x, 1.5) == pow(fabs(x), 1.5) || x < 0;
            same &= atan2l(x, 0.5) == atan2(x, 0.5) && hypotl(x, 2.0) == hypot(x, 2.0) && fmodl(x, 0.7) == fmod(x, 0.7);
            same &= remainderl(x, 0.7) == remainder(x, 0.7) && copysignl(x, -1.0) == copysign(x, -1.0);
            same &= fdiml(x, 1.0) == fdim(x, 1.0) && fmaxl(x, 1.0) == fmax(x, 1.0) && fminl(x, 1.0) == fmin(x, 1.0);
            same &= fmal(x, 3.0, 1.0) == fma(x, 3.0, 1.0) && fabsl(x) == fabs(x) && nextafterl(x, 0.0) == nextafter(x, 0.0);
            same &= nexttowardl(x, 0.0L) == nextafter(x, 0.0) && ldexpl(x, 3) == ldexp(x, 3) && scalbnl(x, -2) == scalbn(x, -2);
            same &= scalblnl(x, 5L) == scalbln(x, 5L) && logbl(x) == logb(x) && ilogbl(x) == ilogb(x);
            same &= erfl(x) == erf(x) && lgammal(x) == lgamma(x);
            if (x > 0) same &= logl(x) == log(x) && log2l(x) == log2(x) && log10l(x) == log10(x) && sqrtl(x) == sqrt(x);
            if (x > -1) same &= log1pl(x) == log1p(x);
            if (x >= -1 && x <= 1) same &= asinl(x) == asin(x) && acosl(x) == acos(x) && atanhl(x) == atanh(x);
            if (x >= 1) same &= acoshl(x) == acosh(x);
            int e1 = 0, e2 = 0, q1 = 0, q2 = 0;
            long double ip1 = 0; double ip2 = 0;
            same &= frexpl(x, &e1) == frexp(x, &e2) && e1 == e2;
            same &= modfl(x, &ip1) == modf(x, &ip2) && ip1 == ip2;
            same &= remquol(x, 0.7, &q1) == remquo(x, 0.7, &q2) && q1 == q2;
        }
        say_int(same);
        say_int(isnan(nanl("")) != 0);
        """, """
        1
        1
        """, math_prelude)

// The math functions by shape, every one with a float form `f` and, where long double is a double,
// an `l` form.
private val unary_names: [34]string = ["acos", "asin", "atan", "cos", "sin", "tan", "acosh", "asinh",
    "atanh", "cosh", "sinh", "tanh", "exp", "exp2", "expm1", "log", "log10", "log1p", "log2", "logb",
    "cbrt", "fabs", "sqrt", "erf", "erfc", "lgamma", "tgamma", "ceil", "floor", "nearbyint", "rint",
    "round", "trunc", "nan"]
private val binary_names: [11]string = ["atan2", "hypot", "pow", "fmod", "remainder", "copysign",
    "nextafter", "nexttoward", "fdim", "fmax", "fmin"]
private val integer_names: [5]string = ["ilogb", "lrint", "llrint", "lround", "llround"]
private val other_names: [7]string = ["fma", "frexp", "ldexp", "scalbn", "scalbln", "modf", "remquo"]

// Every name a C library's libm would define, in each form.
private libm_names() -> Buf[string]
    var all: Buf[string] = buf()
    for list in [unary_names[..], binary_names[..], integer_names[..], other_names[..]]
        for n in list
            all.push(n)
            all.push(n + "f")
            all.push(n + "l")
    all

private check_no_libm(listing: string, prefix: string)
    val names = libm_names()
    for line in split(listing, "\n")
        val sym = line.trim()
        for n in names.view()
            if sym == prefix + n then panic(f"the archive calls '$sym' undefined:\n$listing")

// A sysl function that calls every math function in all three forms, so that a bare-metal archive
// built from it holds the code of each: an archive keeps only what something reaches.
private probe_source() -> string
    var s = "module sh.sysl.bare\n\nimport sh.sysl.cstd.*\n\n@export(\"bare_probe\")\n"
    s += "bare_probe(x: real, y: real, z: real, f: f32, g: f32, h: f32) -> real\n"
    s += "    var r = 0.0\n    var e: i32 = 0\n    var ip = 0.0\n    var fp: f32 = 0.0\n"
    for n in unary_names
        if n == "nan"
            s += "    r += nan(null) + real(nanf(null)) + nanl(null)\n"
        else
            s += f"    r += $n(x) + real(${n}f(f)) + ${n}l(x)\n"
    for n in binary_names
        if n == "nexttoward"
            s += "    r += nexttoward(x, y) + real(nexttowardf(f, y)) + nexttowardl(x, y)\n"
        else
            s += f"    r += $n(x, y) + real(${n}f(f, g)) + ${n}l(x, y)\n"
    for n in integer_names
        s += f"    r += real($n(x)) + real(${n}f(f)) + real(${n}l(x))\n"
    s += "    r += fma(x, y, z) + real(fmaf(f, g, h)) + fmal(x, y, z)\n"
    s += "    r += frexp(x, &e) + real(frexpf(f, &e)) + frexpl(x, &e)\n"
    s += "    r += ldexp(x, 3) + real(ldexpf(f, 3)) + ldexpl(x, 3)\n"
    s += "    r += scalbn(x, 3) + real(scalbnf(f, 3)) + scalbnl(x, 3)\n"
    s += "    r += scalbln(x, Long(3)) + real(scalblnf(f, Long(3))) + scalblnl(x, Long(3))\n"
    s += "    r += modf(x, &ip) + real(modff(f, &fp)) + modfl(x, &ip)\n"
    s += "    r += remquo(x, y, &e) + real(remquof(f, g, &e)) + remquol(x, y, &e)\n"
    s += "    r\n"
    s

// Every function cstd exports is computed by cstd: none of the math reaches a C library, so the
// archive links on a board with no libm and its `sin` does not call itself through one. On the host
// that is the archive the suite builds; on a 32-bit Arm board -- where LLVM would lower a double
// square root or floor to a call -- it is a small project depending on cstd whose one function calls
// all of them; on AArch64 it is cstd's own Linux C runtime, `linux/`, which keeps every export.
@test("the archive's math calls no libm symbol, on the host and on the bare-metal targets")
math_needs_no_libm()
    val host = capture("nm", ["-u", archive()]).unwrap()
    assert(host.status.ok())
    check_no_libm(host.text, "_")
    val defined = capture("nm", ["-gU", archive()]).unwrap()
    for n in unary_names do assert(defined.text.contains(f" _$n\n") && defined.text.contains(f" _${n}f\n"))

    val root = current_dir().unwrap()
    val tmp = make_temp_dir("cstd-bare").unwrap()
    make_dir_all(f"$tmp/sh/sysl/bare").unwrap()
    write_text(f"$tmp/package.hocon", "package {\n  name = \"bare\"\n  version = \"0.1.0\"\n}\n\n" +
        f"dependencies {\n  cstd { path = \"$root\" }\n}\n").unwrap()
    write_text(f"$tmp/sh/sysl/bare/bare.sysl", probe_source()).unwrap()
    val thumb = capture(compiler(), ["build-c", tmp, "--target", "thumb-freestanding-softfp",
        "-o", f"$tmp/bare.a"], stderr = true).unwrap()
    if !thumb.status.ok() then panic(f"build-c for thumb failed:\n${thumb.err.unwrap_or("")}")
    val thumb_defined = capture("nm", ["-g", f"$tmp/bare.a"]).unwrap()
    assert(thumb_defined.text.contains(" T sin\n") && thumb_defined.text.contains(" T sqrt\n"))
    check_no_libm(capture("nm", ["-u", f"$tmp/bare.a"]).unwrap().text, "")

    val a64 = capture(compiler(), ["build-c", "linux", "--target", "aarch64-freestanding",
        "-o", f"$tmp/linux.a"], stderr = true).unwrap()
    if !a64.status.ok() then panic(f"build-c of linux failed:\n${a64.err.unwrap_or("")}")
    val a64_defined = capture("nm", ["-g", f"$tmp/linux.a"]).unwrap()
    assert(a64_defined.text.contains(" T sin\n") && a64_defined.text.contains(" T tgammaf\n"))
    check_no_libm(capture("nm", ["-u", f"$tmp/linux.a"]).unwrap().text, "")
    remove_dir_all(tmp).unwrap()
end math_needs_no_libm