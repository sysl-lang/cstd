@test("nan and nanf answer the default quiet NaN whatever the tag")
math_nan()
    c_case(raw"""
        say_d(nan("")); say_d(nan("123")); say_fl(nanf("")); say_fl(nanf("x"));
        """, """
        7ff8000000000000
        7ff8000000000000
        7fc00000
        7fc00000
        """, math_prelude)

@test("errno: EDOM for a domain error, ERANGE for a pole and an overflow, nothing for an underflow")
math_errno_contract()
    c_case(raw"""
        errno = 0;
        say_de(sqrt(-1.0)); say_de(log(-1.0)); say_de(acos(2.0)); say_de(asin(-1.5));
        say_de(fmod(1.0, 0.0)); say_de(fmod(HUGE_VAL, 1.0)); say_de(remainder(1.0, 0.0));
        say_de(pow(-8.0, 1.0 / 3.0)); say_de(sin(HUGE_VAL)); say_de(cos(-HUGE_VAL)); say_de(tan(HUGE_VAL));
        say_de(tgamma(-1.0)); say_de(tgamma(-HUGE_VAL)); say_de(acosh(0.5)); say_de(atanh(2.0));
        say_de(log1p(-2.0)); say_de(fma(HUGE_VAL, 0.0, 1.0));
        say_de(log(0.0)); say_de(log(-0.0)); say_de(log2(0.0)); say_de(log10(0.0)); say_de(log1p(-1.0));
        say_de(logb(0.0)); say_de(pow(0.0, -1.0)); say_de(pow(-0.0, -3.0)); say_de(atanh(1.0));
        say_de(atanh(-1.0)); say_de(lgamma(0.0)); say_de(lgamma(-2.0)); say_de(tgamma(0.0)); say_de(tgamma(-0.0));
        say_de(exp(1000.0)); say_de(pow(10.0, 400.0)); say_de(cosh(800.0)); say_de(sinh(-800.0));
        say_de(ldexp(1.0, 2000)); say_de(nextafter(from_bits(0x7fefffffffffffffULL), HUGE_VAL));
        say_de(expm1(800.0)); say_de(hypot(from_bits(0x7fefffffffffffffULL), 1e308));
        say_de(expf(100.0f)); say_de(powf(10.0f, 40.0f));
        say_de(exp(-1000.0)); say_de(ldexp(1.0, -1080)); say_de(pow(10.0, -400.0)); say_de(erfc(30.0));
        say_de(exp(HUGE_VAL)); say_de(log(HUGE_VAL)); say_de(sqrt(NAN)); say_de(pow(NAN, 0.0));
        """, """
        7ff8000000000000 33
        7ff8000000000000 33
        7ff8000000000000 33
        7ff8000000000000 33
        7ff8000000000000 33
        7ff8000000000000 33
        7ff8000000000000 33
        7ff8000000000000 33
        7ff8000000000000 33
