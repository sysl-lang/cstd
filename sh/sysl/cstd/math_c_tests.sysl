@test("C Annex F's special values: signed zeros, the exact answers, and the infinities and NaNs")
math_annex_f()
    c_case(raw"""
        say_d(pow(-1.0, HUGE_VAL)); say_d(pow(-1.0, -HUGE_VAL)); say_d(pow(1.0, NAN)); say_d(pow(NAN, -0.0));
        say_d(pow(-0.0, 3.0)); say_d(pow(-0.0, 4.0)); say_d(pow(0.0, -HUGE_VAL)); say_d(pow(-HUGE_VAL, -3.0));
        say_d(pow(0.5, HUGE_VAL)); say_d(pow(2.0, -HUGE_VAL)); say_d(pow(-2.0, 3.0)); say_d(pow(3.0, 4.0));
        say_d(atan2(0.0, -0.0)); say_d(atan2(-0.0, -0.0)); say_d(atan2(0.0, 0.0)); say_d(atan2(-0.0, 0.0));
        say_d(atan2(1.0, 0.0)); say_d(atan2(-1.0, -0.0)); say_d(atan2(HUGE_VAL, -HUGE_VAL)); say_d(atan2(-1.0, HUGE_VAL));
        say_d(hypot(HUGE_VAL, NAN)); say_d(hypot(NAN, -HUGE_VAL)); say_d(hypot(3.0, 4.0));
        say_d(sqrt(-0.0)); say_d(sqrt(16.0)); say_d(cbrt(-27.0)); say_d(exp(0.0)); say_d(exp2(10.0));
        say_d(log(1.0)); say_d(log2(1024.0)); say_d(log10(1e15)); say_d(expm1(-0.0)); say_d(log1p(-0.0));
        say_d(sin(-0.0)); say_d(tan(-0.0)); say_d(cos(0.0)); say_d(asin(-0.0)); say_d(acos(1.0)); say_d(atan(-HUGE_VAL));
        say_d(sinh(-0.0)); say_d(tanh(-HUGE_VAL)); say_d(asinh(-0.0)); say_d(atanh(-0.0)); say_d(acosh(1.0));
        say_d(erf(-0.0)); say_d(erf(-HUGE_VAL)); say_d(erfc(-HUGE_VAL)); say_d(tgamma(5.0)); say_d(lgamma(1.0));
        say_d(lgamma(2.0)); say_d(fmod(-0.0, 1.0)); say_d(fmod(5.5, HUGE_VAL)); say_d(remainder(5.0, 2.0));
        say_d(fmax(-0.0, 0.0)); say_d(fmin(-0.0, 0.0)); say_d(fmax(NAN, 2.0)); say_d(fdim(1.0, 2.0));
        say_d(round(-0.5)); say_d(rint(2.5)); say_d(trunc(-0.7)); say_d(ceil(-0.5)); say_d(floor(-0.5));
        say_d(fma(1.0, 2.0, -2.0)); say_d(fma(2.0, 3.0, 4.0)); say_d(modf(-3.5, &(double){0}));
