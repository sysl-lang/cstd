module sh.sysl.cstd

// `malloc` and its family over `sbrk`: `Heap` (`heap.sysl`) does the bookkeeping, and `BreakHeap`
// moves the break when the heap needs more memory. One heap per program and no lock around it — two
// threads allocating at once would corrupt it.
//
// On a bare-metal target the four are weak defaults over `board_heap`. With cstd's own `sbrk`, which
// answers ENOSYS, every allocation fails with ENOMEM; a board that defines `sbrk` over its heap region
// has a working allocator with nothing else to write, and a board with an allocator of its own
// replaces all four. The Linux half exports the same four strongly over its own `BreakHeap`, with the
// kernel's `brk` behind its `sbrk`.

#if freestanding

private extern "sbrk" c_sbrk(by: isize) -> *u8

// `sbrk`'s failure answer, `(void *)-1`.
private const NO_BREAK: usize = usize::Max

private round_to(n: usize, to: usize) -> usize = (n + to - 1) & ~(to - 1)

// A `Heap` that grows by moving the break, at least `step` bytes at a time where `sbrk` allows it and
// by exactly what it needs where it does not.
struct BreakHeap
    heap: Heap
    step: usize

impl BreakHeap
    // Moves the break so the heap has `more` bytes past its top. The first growth also aligns the
    // heap's start to 16 bytes. False when `sbrk` refuses, and when something else has moved the break
    // since the heap last grew: the heap is one run of memory ending at the break, and the bytes
    // between its top and the break are the program's.
    grow(*self, more: usize) -> bool
        val now = usize(c_sbrk(0))
        if now == NO_BREAK then return false
        if self.heap.top != 0 && self.heap.top != now then return false
        val from = if self.heap.top == 0 then round_to(now, HEAP_ALIGN) else now
        if more > usize::Max - from - self.step then return false
        for step in [self.step, HEAP_ALIGN]
            val to = round_to(from + more, step)
            if usize(c_sbrk(isize(to - now))) == now
                self.heap.grow(from, to)
                return true
        false

    malloc(*self, n: usize) -> *u8
        loop
            val p = self.heap.alloc(n)
            if p != null then return p
            val more = self.heap.shortfall(n)
            if more == 0 || !self.grow(more)
                errno = ENOMEM
                return null

    free(*self, p: *u8) = self.heap.release(p)

    calloc(*self, count: usize, size: usize) -> *u8
        if size != 0 && count > usize::Max / size
            errno = ENOMEM
            return null
        val n = count * size
        val p = self.malloc(n)
        if p != null then memset(p, 0, n)
        p

    // In place when the block can be cut or can take its free neighbour, or is the last before the
    // break and the break can move; otherwise a new block, the bytes copied, the old one freed.
    realloc(*self, p: *u8, n: usize) -> *u8
        if p == null then return self.malloc(n)
        if self.heap.resize(p, n) then return p
        val more = self.heap.resize_shortfall(p, n)
        if more != 0 && self.grow(more) && self.heap.resize(p, n) then return p
        val q = self.malloc(n)
        if q == null then return null
        val keep = self.heap.usable(p)
        memcpy(q, p, if keep < n then keep else n)
        self.heap.release(p)
        q

private var board_heap: BreakHeap = BreakHeap(Heap(0, 0, 0), 4 * 1024)

@export("malloc", weak)
board_malloc(n: usize) -> *u8 = board_heap.malloc(n)

@export("free", weak)
board_free(p: *u8) = board_heap.free(p)

@export("calloc", weak)
board_calloc(count: usize, size: usize) -> *u8 = board_heap.calloc(count, size)

@export("realloc", weak)
board_realloc(p: *u8, n: usize) -> *u8 = board_heap.realloc(p, n)

#endif
