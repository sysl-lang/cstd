// The sign and exponent bits.
private[cstd] top12(x: real) -> u32 = u32(x.bits() >> 52)

// scale × (1 + tmp) where that may overflow or underflow, scale's bits being `sbits` with an
// exponent that may have overflowed into the sign bit. `ki`'s sign says which way: positive k may
// overflow, negative k may underflow. `big_k` is how far a positive k's exponent may have gone past
// the top, 1009 for exp and 1 for exp2.
private exp_special(tmp: real, sbits_in: u64, ki: u64, exp2_form: bool) -> real
    var sbits = sbits_in
    if ki & 0x80000000 == 0
        if exp2_form
            sbits -= 1u64 << 52
            val scale = real.from_bits(sbits)
            return checked_overflow(2.0 * (scale + scale * tmp))
        sbits -= 1009u64 << 52
        val scale = real.from_bits(sbits)
        // 2^1009
        return checked_overflow(5.486124068793689e303 * (scale + scale * tmp))
    // k < 0: care in the subnormal range.
    sbits += 1022u64 << 52
    val scale = real.from_bits(sbits)
    var y = scale + scale * tmp
    if y < 1.0
        // Round y to the right precision before scaling it into the subnormal range, to avoid the
        // double rounding that would cost 0.5 ulp.
        var lo = scale - y + scale * tmp
        val hi = 1.0 + y
        lo = 1.0 - hi + y + lo
        y = (hi + lo) - 1.0
        if y == 0.0 then y = 0.0
    2.2250738585072014e-308 * y
end exp_special

@export("exp")
exp(x: real) -> real
    var abstop = top12(x) & 0x7ff
    if abstop - 0x3c9 >= 0x408 - 0x3c9
        // Tiny: 1 + x, which also gives exp(0) = 1 exactly.
        if abstop - 0x3c9 >= 0x80000000 then return 1.0 + x
        if abstop >= 0x409
            if x.bits() == 0xfff0000000000000 then return 0.0
            if abstop >= 0x7ff then return 1.0 + x
            if x.bits() >> 63 != 0 then return underflow(false)
            return overflow(false)
        // Large x is handled below.
        abstop = 0

    // exp(x) = 2^(k/N) × exp(r), with exp(r) in [2^(-1/2N), 2^(1/2N)]; x = ln2/N × k + r.
    val z = exp_invln2n * x
    var kd = z + exp_shift
    val ki = kd.bits()
    kd -= exp_shift
    val r = x + kd * exp_negln2hin + kd * exp_negln2lon
    // 2^(k/N) ~= scale × (1 + tail).
    val idx = 2 * (ki % exp_n)
    val top = ki << (52 - exp_table_bits)
    val tail = real.from_bits(exp_tab[idx])
    // A valid scale only for -1023N < k < 1024N.
    val sbits = exp_tab[idx + 1] + top
    // exp(x) = 2^(k/N) × exp(r) ~= scale + scale × (tail + exp(r) - 1).
    val r2 = r * r
    val tmp = tail + r + r2 * (exp_c2 + r * exp_c3) + r2 * r2 * (exp_c4 + r * exp_c5)
    if abstop == 0 then return exp_special(tmp, sbits, ki, false)
    val scale = real.from_bits(sbits)
    scale + scale * tmp
end exp

@export("exp2")
exp2(x: real) -> real
    var abstop = top12(x) & 0x7ff
    if abstop - 0x3c9 >= 0x408 - 0x3c9
        if abstop - 0x3c9 >= 0x80000000 then return 1.0 + x
        if abstop >= 0x409
            if x.bits() == 0xfff0000000000000 then return 0.0
            if abstop >= 0x7ff then return 1.0 + x
            if x.bits() >> 63 == 0 then return overflow(false)
            // -1075.0
            if x.bits() >= 0xc090cc0000000000 then return underflow(false)
        // 928.0: large x is handled below.
        if 2 * x.bits() > 2 * 0x408d000000000000u64 then abstop = 0

    // exp2(x) = 2^(k/N) × 2^r, with 2^r in [2^(-1/2N), 2^(1/2N)]; x = k/N + r.
    var kd = x + exp2_shift
    val ki = kd.bits()
    kd -= exp2_shift
    val r = x - kd
    val idx = 2 * (ki % exp_n)
    val top = ki << (52 - exp_table_bits)
    val tail = real.from_bits(exp_tab[idx])
    val sbits = exp_tab[idx + 1] + top
    val r2 = r * r
    val tmp = tail + r * exp2_c1 + r2 * (exp2_c2 + r * exp2_c3) + r2 * r2 * (exp2_c4 + r * exp2_c5)
    if abstop == 0 then return exp_special(tmp, sbits, ki, true)
    val scale = real.from_bits(sbits)
    scale + scale * tmp
end exp2

// fdlibm's expm1 constants: the overflow threshold, ln2 in two parts, 1/ln2, and the rational
// approximation's coefficients.
private val expm1_o_threshold: real = 7.09782712893383973096e2   // 0x40862E42 0xFEFA39EF
private val expm1_ln2_hi: real = 6.93147180369123816490e-1       // 0x3fe62e42 0xfee00000
private val expm1_ln2_lo: real = 1.90821492927058770002e-10      // 0x3dea39ef 0x35793c76
private val expm1_invln2: real = 1.44269504088896338700e0        // 0x3ff71547 0x652b82fe
private val expm1_q1: real = -3.33333333333331316428e-2          // BFA11111 111110F4
private val expm1_q2: real = 1.58730158725481460165e-3           // 3F5A01A0 19FE5585
private val expm1_q3: real = -7.93650757867487942473e-5          // BF14CE19 9EAADBB7
private val expm1_q4: real = 4.00821782732936239552e-6           // 3ED0CFCA 86E65239
private val expm1_q5: real = -2.01099218183624371326e-7          // BE8AFDB7 6E09C32D

@export("expm1")
expm1(x_in: real) -> real
    var x = x_in
    val hx = hi_word(x) & 0x7fffffff
    val sign = sign_bit(x)
    var k: i32 = 0
    var c = 0.0

    // Huge and non-finite arguments.
    if hx >= 0x4043687a
        // |x| >= 56 ln2
        if x != x then return x
        if sign then return -1.0
        if x > expm1_o_threshold then return if x == real.infinity then x else overflow(false)

    // Argument reduction.
    if hx > 0x3fd62e42
        // |x| > ln2/2
        var hi = 0.0
        var lo = 0.0
        if hx < 0x3ff0a2b2
            // and |x| < 1.5 ln2
            if !sign
                hi = x - expm1_ln2_hi
                lo = expm1_ln2_lo
                k = 1
            else
                hi = x + expm1_ln2_hi
                lo = -expm1_ln2_lo
                k = -1
        else
            k = i32(expm1_invln2 * x + (if sign then -0.5 else 0.5))
            val t = real(k)
            // t × ln2_hi is exact here.
            hi = x - t * expm1_ln2_hi
            lo = t * expm1_ln2_lo
        x = hi - lo
        c = (hi - x) - lo
    elif hx < 0x3c900000
        // |x| < 2^-54
        return x

    // x is now in the primary range.
    val hfx = 0.5 * x
    val hxs = x * hfx
    val r1 = 1.0 + hxs * (expm1_q1 + hxs * (expm1_q2 + hxs * (expm1_q3 + hxs * (expm1_q4 + hxs * expm1_q5))))
    val t = 3.0 - r1 * hfx
    var e = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0 then return x - (x * e - hxs)
    e = x * (e - c) - c
    e -= hxs
    // exp(x) ~ 2^k (x_reduced - e + 1)
    if k == -1 then return 0.5 * (x - e) - 0.5
    if k == 1
        if x < -0.25 then return -2.0 * (e - (x + 0.5))
        return 1.0 + 2.0 * (x - e)
    val twopk = real.from_bits(u64(0x3ff + k) << 52)
    if k < 0 || k > 56
        // exp(x) - 1 is close enough to exp(x).
        var y = x - e + 1.0
        if k == 1024
            y = y * 2.0 * 8.98846567431158e307
        else
            y = y * twopk
        return y - 1.0
    val twomk = real.from_bits(u64(0x3ff - k) << 52)
    if k < 20 then (x - e + (1.0 - twomk)) * twopk else (x - (e + twomk) + 1.0) * twopk
end expm1

@export("expf")
expf(x: f32) -> f32 = narrow(exp(real(x)))

@export("exp2f")
exp2f(x: f32) -> f32 = narrow(exp2(real(x)))

@export("expm1f")
expm1f(x: f32) -> f32 = narrow(expm1(real(x)))
