module sh.sysl.cstd

// `<math.h>`'s exponentials: `exp`, `exp2` and `expm1`, and their float forms.
//
// `exp` and `exp2` are Arm's optimized-routines as musl 1.2.6 carries them (`exp.c`, `exp2.c`,
// `exp_data.c`, MIT): x = k/N + r with N = 128, 2^(k/N) from a table of 128 pairs, and a polynomial
// of degree five for the rest. Both stay within 0.52 ulp. `expm1` is fdlibm's (`expm1.c`): a
// rational approximation on [-ln2/2, ln2/2] with the reduction carried in two parts so that a tiny
// result keeps its digits.
//
// The float forms compute in double and round once.
//
// exp and exp2: Copyright (c) 2018, Arm Limited. SPDX-License-Identifier: MIT.
// expm1, from fdlibm, whose terms ask that its notice be kept with the code:
//
//     Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//     Developed at SunSoft, a Sun Microsystems, Inc. business.
//     Permission to use, copy, modify, and distribute this software is freely granted,
//     provided that this notice is preserved.

// `pow` shares the table, the reduction constants and the polynomial (`math_pow.sysl`).
private[cstd] val exp_table_bits: u64 = 7
private[cstd] val exp_n: u64 = 128

// N/ln2, -ln2/N in two parts, and 1.5 × 2^52 for rounding to an integer by addition.
private[cstd] val exp_invln2n: real = 184.6649652337873
private[cstd] val exp_negln2hin: real = -0.005415212348111709
private[cstd] val exp_negln2lon: real = -1.2864023111638346e-14
private[cstd] val exp_shift: real = 6755399441055744.0

// exp's polynomial: abs error 1.555 × 2^-66, 0.509 ulp.
private[cstd] val exp_c2: real = 0x1.ffffffffffdbdp-2
private[cstd] val exp_c3: real = 0x1.555555555543cp-3
private[cstd] val exp_c4: real = 0x1.55555cf172b91p-5
private[cstd] val exp_c5: real = 0x1.1111167a4d017p-7

// exp2's: abs error 1.2195 × 2^-65, 0.507 ulp; and its shift, 1.5 × 2^52 / N.
private val exp2_shift: real = 52776558133248.0
private val exp2_c1: real = 0x1.62e42fefa39efp-1
private val exp2_c2: real = 0x1.ebfbdff82c424p-3
private val exp2_c3: real = 0x1.c6b08d70cf4b5p-5
private val exp2_c4: real = 0x1.3b2abd24650ccp-7
private val exp2_c5: real = 0x1.5d7e09b4e3a84p-10

// 2^(k/N) ~= H[k] × (1 + T[k]) for k in [0, N): tab[2k] is T[k]'s bits, and tab[2k + 1] is H[k]'s
// bits less (k << 52) / N, so that adding k << (52 - 7) puts the exponent in.
