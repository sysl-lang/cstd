module sh.sysl.cstd

@tests

// The float conversions of the printf family, called from C.
//
// Each `say_f` line is the count `vsnprintf` answered, then the text between bars. Every expected
// value is the exact decimal value of the double, rounded half to even where the precision says --
// C's answer, and glibc's and musl's. A long expansion is the double's exact value, `m × 2^e`
// written out in decimal: 1e300's double is not 10^300, and its 301 digits are what it holds.

@test("%f takes every flag, a width and a precision")
printf_f_flags()
    c_case(raw"""
        say_f("%f", 2.5);
        say_f("%.2f", -0.125);
        say_f("%f", 0.0);
        say_f("%f", -0.0);
        say_f("%.0f", 0.0);
        say_f("%#.0f", 3.0);
        say_f("%#.0f", -0.0);
        say_f("%+f", 1.5);
        say_f("% f", 1.5);
        say_f("%+ f", 1.5);
        say_f("%+f", -1.5);
        say_f("%10.3f", 3.14159);
        say_f("%-10.3f", 3.14159);
        say_f("%010.3f", -3.14159);
        say_f("%+010.2f", 2.5);
        say_f("% 010.2f", 2.5);
        say_f("%-010.2f", 2.5);
        say_f("%3f", 123.5);
        say_f("%.10f", 0.3333333333333333);
        say_f("%f", 123456789.125);
        say_f("%.3f", 1e-10);
        say_f("%5.1f", 99.96);
        say_f("%.0f", 999.5);
        say_f("%.0f", 1000.5);
        say_f("%.1f", 0.95);
        say_f("%.15f", 1.0);
        say_f("%#f", 7.0);
        say_f("%*.*f", 10, 2, 3.14159);
        say_f("%*.*f", -10, 1, 2.25);
        say_f("%.*f", -1, 2.5);
        say_f("%F", 2.5);
        """, raw"""
        8|2.500000|
        5|-0.12|
        8|0.000000|
        9|-0.000000|
        1|0|
        2|3.|
        3|-0.|
        9|+1.500000|
        9| 1.500000|
        9|+1.500000|
        9|-1.500000|
        10|     3.142|
        10|3.142     |
        10|-00003.142|
        10|+000002.50|
        10| 000002.50|
        10|2.50      |
        10|123.500000|
        12|0.3333333333|
        16|123456789.125000|
        5|0.000|
        5|100.0|
        4|1000|
        4|1000|
        3|0.9|
        17|1.000000000000000|
        8|7.000000|
        10|      3.14|
        10|2.2       |
        8|2.500000|
        8|2.500000|
        """)

@test("%f and %e round the exact value half to even at the precision")
printf_rounding()
    c_case(raw"""
        say_f("%.0f", 0.5);
        say_f("%.0f", 1.5);
        say_f("%.0f", 2.5);
        say_f("%.0f", 3.5);
        say_f("%.0f", -0.5);
        say_f("%.0f", -2.5);
        say_f("%.0f", 0.49999999999999994);
        say_f("%.0f", 0.501);
        say_f("%.1f", 0.25);
        say_f("%.1f", 0.75);
        say_f("%.1f", 0.35);
        say_f("%.1f", 0.05);
        say_f("%.2f", 0.125);
        say_f("%.2f", 0.375);
        say_f("%.2f", 1.005);
        say_f("%.3f", 2.0005);
        say_f("%.20f", 0.1);
        say_f("%.17f", 0.1);
        say_f("%.30f", 0.1);
        say_f("%.0f", 4503599627370497.0);
        say_f("%.0f", 9007199254740993.0);
        say_f("%.0f", 1e23);
        say_f("%.1f", 1e15);
        say_f("%.0e", 2.5);
        say_f("%.0e", 3.5);
        say_f("%.0e", 0.25);
        say_f("%.1e", 0.25);
        say_f("%.2e", 9.995);
        say_f("%.2e", 9.9951);
        say_f("%.3e", 1.0005);
        say_f("%.0e", 9.5);
        say_f("%.0e", 8.5);
        """, raw"""
        1|0|
        1|2|
        1|2|
        1|4|
        2|-0|
        2|-2|
        1|0|
        1|1|
        3|0.2|
        3|0.8|
        3|0.3|
        3|0.1|
        4|0.12|
        4|0.38|
        4|1.00|
        5|2.001|
        22|0.10000000000000000555|
        19|0.10000000000000001|
        32|0.100000000000000005551115123126|
        16|4503599627370497|
        16|9007199254740992|
        23|99999999999999991611392|
        18|1000000000000000.0|
        5|2e+00|
        5|4e+00|
        5|2e-01|
        7|2.5e-01|
        8|9.99e+00|
        8|1.00e+01|
        9|1.000e+00|
        5|1e+01|
        5|8e+00|
        """)

@test("%e takes every flag, and its exponent grows to three digits")
printf_e_flags()
    c_case(raw"""
        say_f("%e", 1234.5);
        say_f("%E", 0.0);
        say_f("%e", -0.0);
        say_f("%e", 1.0);
        say_f("%.0e", 12345.0);
        say_f("%#.0e", 12345.0);
        say_f("%e", 1e100);
        say_f("%e", 1e-100);
        say_f("%E", 1.5e-300);
        say_f("%e", 123456789.0);
        say_f("%+12.3e", 1.5);
        say_f("%-12.3e", 1.5);
        say_f("%012.3e", -1.5);
        say_f("% e", 1.0);
        say_f("%+e", 0.0);
        say_f("%.10e", 0.1);
        say_f("%e", 0.000123456789);
        say_f("%15.2E", -6.02214076e23);
        """, raw"""
        12|1.234500e+03|
        12|0.000000E+00|
        13|-0.000000e+00|
        12|1.000000e+00|
        5|1e+04|
        6|1.e+04|
        13|1.000000e+100|
        13|1.000000e-100|
        13|1.500000E-300|
        12|1.234568e+08|
        12|  +1.500e+00|
        12|1.500e+00   |
        12|-001.500e+00|
        13| 1.000000e+00|
        13|+0.000000e+00|
        16|1.0000000000e-01|
        12|1.234568e-04|
        15|      -6.02E+23|
        """)

@test("%g switches form at C's points and drops trailing zeros unless # keeps them")
printf_g_rules()
    c_case(raw"""
        say_f("%g", 100000.0);
        say_f("%g", 1000000.0);
        say_f("%G", 0.0001);
        say_f("%g", 0.00001);
        say_f("%g", 1e-5);
        say_f("%g", 1e-4);
        say_f("%g", 1e5);
        say_f("%g", 1e6);
        say_f("%g", 0.0001234);
        say_f("%g", 0.00001234);
        say_f("%g", 123456.0);
        say_f("%g", 1234567.0);
        say_f("%g", 999999.5);
        say_f("%g", 999999.4);
        say_f("%g", 0.000099999995);
        say_f("%g", 0.0);
        say_f("%g", -0.0);
        say_f("%#g", 1.0);
        say_f("%#g", 0.0);
        say_f("%#g", 123456.0);
        say_f("%#g", 1e6);
        say_f("%.0g", 0.5);
        say_f("%.0g", 2.5);
        say_f("%.0g", 3.5);
        say_f("%.1g", 15.0);
        say_f("%.1g", 25.0);
        say_f("%.3g", 1e5);
        say_f("%.3g", 99950.0);
        say_f("%#.3g", 1e5);
        say_f("%.17g", 0.1);
        say_f("%.17g", 1e23);
        say_f("%.17g", 1.0);
        say_f("%10.4g", 3.14159);
        say_f("%-10g", 2.5);
        say_f("%010g", -1.5);
        say_f("%+g", 2.0);
        say_f("% g", 2.0);
        say_f("%G", 1e-10);
        say_f("%g", 100.0);
        say_f("%.2g", 100.0);
        say_f("%g", 0.1);
        say_f("%g", 1.5e300);
        say_f("%g", 3.0);
        say_f("%.10g", 0.3333333333333333);
        say_f("%#.10g", 0.5);
        say_f("%g", 0.0001000001);
        say_f("%g", 123.456);
        """, raw"""
        6|100000|
        5|1e+06|
        6|0.0001|
        5|1e-05|
        5|1e-05|
        6|0.0001|
        6|100000|
        5|1e+06|
        9|0.0001234|
        9|1.234e-05|
        6|123456|
        11|1.23457e+06|
        5|1e+06|
        6|999999|
        6|0.0001|
        1|0|
        2|-0|
        7|1.00000|
        7|0.00000|
        7|123456.|
        11|1.00000e+06|
        3|0.5|
        1|2|
        1|4|
        5|2e+01|
        5|2e+01|
        5|1e+05|
        5|1e+05|
        8|1.00e+05|
        19|0.10000000000000001|
        22|9.9999999999999992e+22|
        1|1|
        10|     3.142|
        10|2.5       |
        10|-0000001.5|
        2|+2|
        2| 2|
        5|1E-10|
        3|100|
        5|1e+02|
        3|0.1|
        8|1.5e+300|
        1|3|
        12|0.3333333333|
        12|0.5000000000|
        6|0.0001|
        7|123.456|
        """)

@test("%a is the exact bits, a subnormal normalised, and a precision rounds half to even")
printf_a_detail()
    c_case(raw"""
        say_f("%a", 1.0);
        say_f("%A", 0.5);
        say_f("%a", 3.0);
        say_f("%a", -2.5);
        say_f("%a", 0.0);
        say_f("%a", -0.0);
        say_f("%a", 0.1);
        say_f("%.1a", 0.1);
        say_f("%.0a", 1.5);
        say_f("%.0a", 2.5);
        say_f("%.0a", 3.5);
        say_f("%.1a", 1.03125);
        say_f("%.1a", 1.09375);
        say_f("%.3a", 1.0);
        say_f("%#a", 1.0);
        say_f("%.15a", 1.0);
        say_f("%.2a", 0.0);
        say_f("%20a", 1.0);
        say_f("%-12a", 1.0);
        say_f("%020a", 1.0);
        say_f("%+a", 1.0);
        say_f("% A", -1.0);
        say_f("%A", DBL_MAX);
        say_f("%a", DBL_MIN);
        say_f("%a", DBL_TRUE_MIN);
        say_f("%a", 0x1p-1023);
        say_f("%a", 0x1.8p-1070);
        say_f("%.1a", DBL_MAX);
        say_f("%.12a", 0x1.0000000000008p+0);
        say_f("%.12a", 0x1.0000000000018p+0);
        """, raw"""
        6|0x1p+0|
        6|0X1P-1|
        8|0x1.8p+1|
        9|-0x1.4p+1|
        6|0x0p+0|
        7|-0x0p+0|
        20|0x1.999999999999ap-4|
        8|0x1.ap-4|
        6|0x2p+0|
        6|0x1p+1|
        6|0x2p+1|
        8|0x1.0p+0|
        8|0x1.2p+0|
        10|0x1.000p+0|
        7|0x1.p+0|
        22|0x1.000000000000000p+0|
        9|0x0.00p+0|
        20|              0x1p+0|
        12|0x1p+0      |
        20|0x000000000000001p+0|
        7|+0x1p+0|
        7|-0X1P+0|
        23|0X1.FFFFFFFFFFFFFP+1023|
        9|0x1p-1022|
        9|0x1p-1074|
        9|0x1p-1023|
        11|0x1.8p-1070|
        11|0x2.0p+1023|
        19|0x1.000000000000p+0|
        19|0x1.000000000002p+0|
        """, prelude = "#include <float.h>")

@test("inf and nan are words, cased by the conversion, signed by the sign bit, never zero-padded")
printf_inf_nan()
    c_case(raw"""
        double inf = from_bits(0x7ff0000000000000ULL);
        double ninf = from_bits(0xfff0000000000000ULL);
        double nan = from_bits(0x7ff8000000000000ULL);
        double nnan = from_bits(0xfff8000000000001ULL);
        say_f("%f", inf);
        say_f("%F", inf);
        say_f("%e", ninf);
        say_f("%E", ninf);
        say_f("%g", inf);
        say_f("%G", nan);
        say_f("%a", inf);
        say_f("%A", nan);
        say_f("%f", nan);
        say_f("%f", nnan);
        say_f("%+f", inf);
        say_f("% f", inf);
        say_f("%+f", nan);
        say_f("%10f", inf);
        say_f("%-10f|", ninf);
        say_f("%010f", inf);
        say_f("%010.3e", nnan);
        say_f("%.0f", inf);
        say_f("%#g", nan);
        """, raw"""
        3|inf|
        3|INF|
        4|-inf|
        4|-INF|
        3|inf|
        3|NAN|
        3|inf|
        3|NAN|
        3|nan|
        4|-nan|
        4|+inf|
        4| inf|
        4|+nan|
        10|       inf|
        11|-inf      ||
        10|       inf|
        10|      -nan|
        3|inf|
        3|nan|
        """)

@test("the extremes print every digit they hold")
printf_extremes()
    c_case(raw"""
        say_f("%f", 1e300);
        say_f("%f", DBL_MAX);
        say_f("%e", DBL_MAX);
        say_f("%.16e", DBL_MAX);
        say_f("%g", DBL_MAX);
        say_f("%.17g", DBL_MAX);
        say_f("%e", DBL_MIN);
        say_f("%.17e", DBL_MIN);
        say_f("%g", DBL_MIN);
        say_f("%.17g", DBL_MIN);
        say_f("%e", DBL_TRUE_MIN);
        say_f("%g", DBL_TRUE_MIN);
        say_f("%.17g", DBL_TRUE_MIN);
        say_f("%.760e", DBL_TRUE_MIN);
        say_f("%.750e", DBL_TRUE_MIN);
        say_f("%f", DBL_TRUE_MIN);
        say_f("%.20f", 1e-300);
        say_f("%.330f", 1e-300);
        say_f("%e", 2.2250738585072009e-308);
        say_f("%.16e", 2.2250738585072009e-308);
        say_f("%e", 1e-320);
        say_f("%.3e", 1e-320);
        say_f("%.40f", 1e-320);
        """, raw"""
        308|.000000|
        316|.000000|
        13|1.797693e+308|
        23|1.7976931348623157e+308|
        12|1.79769e+308|
        23|1.7976931348623157e+308|
        13|2.225074e-308|
        24|2.22507385850720138e-308|
        12|2.22507e-308|
        23|2.2250738585072014e-308|
        13|4.940656e-324|
        12|4.94066e-324|
        23|4.9406564584124654e-324|
        767|4.-324|
        757|4.-324|
        8|0.000000|
        22|0.00000000000000000000|
        332|0.|
        13|2.225074e-308|
        23|2.2250738585072009e-308|
        13|9.999889e-321|
        10|1.000e-320|
        42|0.0000000000000000000000000000000000000000|
        """, prelude = "#include <float.h>")

// The smallest subnormal's exact value ends `…3344 7265 625`: 751 significant digits. At 749
// places the dropped part is exactly a 5, and the even 2 before it stays; at 748 it is 25, under
// half, and rounds down.
@test("a tie at the last digit of a subnormal's 751 rounds to even")
printf_subnormal_tie()
    c_case(raw"""
        char b[1100];
        int n = snprintf(b, sizeof b, "%.749e", DBL_TRUE_MIN);
        say_int(n);
        say_str(b + n - 14);
        n = snprintf(b, sizeof b, "%.748e", DBL_TRUE_MIN);
        say_int(n);
        say_str(b + n - 14);
        n = snprintf(b, sizeof b, "%.1000f", 1.0);
        say_int(n);
        say_str(b + n - 3);
        """, raw"""
        756
        344726562e-324
        755
        334472656e-324
        1002
        000
        """, prelude = "#include <float.h>")

// `L` is not taken: there is no `long double` here, so `%Lf` is copied out as written and its
// argument is not read -- the `%d` after it takes the next one.
@test("%Lf is not a conversion cstd defines")
printf_long_double_refused()
    c_case(raw"""
        say_f("%Lf|%d", 7);
        """, raw"""
        5|%Lf|7|
        """)

@test("snprintf truncates a float field at every boundary and writes nothing past n")
snprintf_truncates_floats()
    c_case(raw"""
        char b[12];
        size_t ns[] = {0, 1, 2, 4, 9, 10};
        for (int i = 0; i < 6; i++) {
            memset(b, '#', sizeof b);
            say_int(snprintf(b + 1, ns[i], "%.6f", -3.25));
            say_bytes(b, sizeof b);
        }
        memset(b, '#', sizeof b);
        say_int(snprintf(b + 1, 6, "%e", 1e100));
        say_bytes(b, sizeof b);
        memset(b, '#', sizeof b);
        say_int(snprintf(b + 1, 5, "%08.2f", 1.5));
        say_bytes(b, sizeof b);
        memset(b, '#', sizeof b);
        say_int(snprintf(b + 1, 7, "%a", 0.1));
        say_bytes(b, sizeof b);
        say_int(snprintf(NULL, 0, "%f", 1e300));
        """, raw"""
        9
        ############
        9
        #[00]##########
        9
        #-[00]#########
        9
        #-3.[00]#######
        9
        #-3.25000[00]##
        9
        #-3.250000[00]#
        13
        #1.000[00]#####
        8
        #0000[00]######
        20
        #0x1.99[00]####
        308
        """)

// Every finite double, printed with seventeen significant digits, reads back as itself; and so
// does its `%a`. The doubles are the bit patterns an LCG walks through, so every exponent and
// every significand pattern turns up, subnormals included.
@test("100,000 pseudo-random doubles round-trip through %.17g and %a and strtod, bit for bit")
printf_strtod_round_trip()
    c_case(raw"""
        unsigned long long state = 0x2545f4914f6cdd1dULL;
        int checked = 0, wrong_g = 0, wrong_a = 0;
        char b[64];
        while (checked < 100000) {
            state = state * 6364136223846793005ULL + 1442695040888963407ULL;
            unsigned long long bits = state ^ (state >> 29);
            if (((bits >> 52) & 0x7ff) == 0x7ff) continue;
            double x = from_bits(bits);
            unsigned long long back;
            sprintf(b, "%.17g", x);
            double y = strtod(b, NULL);
            memcpy(&back, &y, sizeof back);
            if (back != bits) wrong_g++;
            sprintf(b, "%a", x);
            y = strtod(b, NULL);
            memcpy(&back, &y, sizeof back);
            if (back != bits) wrong_a++;
            checked++;
        }
        say_int(checked);
        say_int(wrong_g);
        say_int(wrong_a);
        """, raw"""
        100000
        0
        0
        """)
