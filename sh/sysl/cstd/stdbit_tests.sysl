module sh.sysl.cstd

@tests

// `<stdbit.h>`, called from C.
//
// Two kinds of check. The tables state exact answers for the edge values — 0, all ones, the top bit
// alone, a value whose `bit_ceil` does not fit — worked out by hand, one row per value: the value,
// then leading_zeros, leading_ones, trailing_zeros, trailing_ones, first_leading_zero,
// first_leading_one, first_trailing_zero, first_trailing_one, count_zeros, count_ones,
// has_single_bit, bit_width, bit_floor and bit_ceil. The sweeps compare every function with a
// reference written here bit by bit, over every `unsigned char` and over a spread of patterns for
// the wider types, and print how many answers disagreed. The tables run on an LP64 host, where
// `unsigned long` is 64 bits.

private val prelude: string = raw"""
#include <stdbit.h>

typedef unsigned long long u64;

static unsigned bit_at(u64 v, unsigned i) { return (unsigned)((v >> i) & 1); }

static unsigned r_lz(u64 v, unsigned w) { unsigned n = 0; while (n < w && !bit_at(v, w - 1 - n)) n++; return n; }
static unsigned r_lo(u64 v, unsigned w) { unsigned n = 0; while (n < w && bit_at(v, w - 1 - n)) n++; return n; }
static unsigned r_tz(u64 v, unsigned w) { unsigned n = 0; while (n < w && !bit_at(v, n)) n++; return n; }
static unsigned r_to(u64 v, unsigned w) { unsigned n = 0; while (n < w && bit_at(v, n)) n++; return n; }

static unsigned r_fl0(u64 v, unsigned w) { for (unsigned i = 0; i < w; i++) if (!bit_at(v, w - 1 - i)) return i + 1; return 0; }
static unsigned r_fl1(u64 v, unsigned w) { for (unsigned i = 0; i < w; i++) if (bit_at(v, w - 1 - i)) return i + 1; return 0; }
static unsigned r_ft0(u64 v, unsigned w) { for (unsigned i = 0; i < w; i++) if (!bit_at(v, i)) return i + 1; return 0; }
static unsigned r_ft1(u64 v, unsigned w) { for (unsigned i = 0; i < w; i++) if (bit_at(v, i)) return i + 1; return 0; }

static unsigned r_c1(u64 v, unsigned w) { unsigned n = 0; for (unsigned i = 0; i < w; i++) n += bit_at(v, i); return n; }
static unsigned r_c0(u64 v, unsigned w) { return w - r_c1(v, w); }
static unsigned r_hsb(u64 v, unsigned w) { return r_c1(v, w) == 1; }
static unsigned r_bw(u64 v, unsigned w) { for (unsigned k = w; k > 0; k--) if (bit_at(v, k - 1)) return k; return 0; }
static u64 r_floor(u64 v, unsigned w) { unsigned k = r_bw(v, w); return k == 0 ? 0 : 1ULL << (k - 1); }
static u64 r_ceil(u64 v, unsigned w) {
    u64 p = 1;
    for (unsigned i = 0; i < w; i++) {
        if (p >= v) return p;
        p <<= 1;
    }
    return 0;
}

/* Every function of a suffix against the reference at width W, through the function and through the
 * type-generic macro; the number of answers that disagree. */
 #define CHECK(SUF, T, W)                                                                        \
    static unsigned check_##SUF(T v) {                                                            \
        u64 x = v;                                                                                \
        unsigned bad = 0;                                                                         \
        bad += stdc_leading_zeros_##SUF(v) != r_lz(x, W) || stdc_leading_zeros(v) != r_lz(x, W);  \
        bad += stdc_leading_ones_##SUF(v) != r_lo(x, W) || stdc_leading_ones(v) != r_lo(x, W);    \
        bad += stdc_trailing_zeros_##SUF(v) != r_tz(x, W) || stdc_trailing_zeros(v) != r_tz(x, W);\
        bad += stdc_trailing_ones_##SUF(v) != r_to(x, W) || stdc_trailing_ones(v) != r_to(x, W);  \
        bad += stdc_first_leading_zero_##SUF(v) != r_fl0(x, W)                                    \
            || stdc_first_leading_zero(v) != r_fl0(x, W);                                         \
        bad += stdc_first_leading_one_##SUF(v) != r_fl1(x, W)                                     \
            || stdc_first_leading_one(v) != r_fl1(x, W);                                          \
        bad += stdc_first_trailing_zero_##SUF(v) != r_ft0(x, W)                                   \
            || stdc_first_trailing_zero(v) != r_ft0(x, W);                                        \
        bad += stdc_first_trailing_one_##SUF(v) != r_ft1(x, W)                                    \
            || stdc_first_trailing_one(v) != r_ft1(x, W);                                         \
        bad += stdc_count_zeros_##SUF(v) != r_c0(x, W) || stdc_count_zeros(v) != r_c0(x, W);      \
        bad += stdc_count_ones_##SUF(v) != r_c1(x, W) || stdc_count_ones(v) != r_c1(x, W);        \
        bad += (unsigned)stdc_has_single_bit_##SUF(v) != r_hsb(x, W)                              \
            || (unsigned)stdc_has_single_bit(v) != r_hsb(x, W);                                   \
        bad += stdc_bit_width_##SUF(v) != r_bw(x, W) || stdc_bit_width(v) != r_bw(x, W);          \
        bad += stdc_bit_floor_##SUF(v) != (T)r_floor(x, W) || stdc_bit_floor(v) != (T)r_floor(x, W);\
        bad += stdc_bit_ceil_##SUF(v) != (T)r_ceil(x, W) || stdc_bit_ceil(v) != (T)r_ceil(x, W);  \
        return bad;                                                                               \
    }

CHECK(uc, unsigned char, 8)
CHECK(us, unsigned short, 16)
CHECK(ui, unsigned int, 32)
CHECK(ul, unsigned long, (unsigned)(sizeof(unsigned long) * 8))
CHECK(ull, unsigned long long, 64)

/* Prints "checked bad": every byte pattern at the bottom and at the top of the width, each and its
 * complement, then the one-bit values, the all-ones-but-one values, 2^k - 1 and 2^k + 1. */
 #define SWEEP(SUF, T, W)                                                                        \
    static void sweep_##SUF(void) {                                                               \
        unsigned checked = 0, bad = 0;                                                            \
        for (unsigned b = 0; b < 256; b++) {                                                      \
            T lo = (T)b, hi = (T)((u64)b << ((W) - 8));                                           \
            bad += check_##SUF(lo); bad += check_##SUF((T)~lo);                                   \
            bad += check_##SUF(hi); bad += check_##SUF((T)~hi);                                   \
            checked += 4;                                                                         \
        }                                                                                         \
        for (unsigned k = 0; k < (W); k++) {                                                      \
            T one = (T)((T)1 << k);                                                               \
            bad += check_##SUF(one); bad += check_##SUF((T)~one);                                 \
            bad += check_##SUF((T)(one - 1)); bad += check_##SUF((T)(one + 1));                   \
            checked += 4;                                                                         \
        }                                                                                         \
        put_u(checked); say_ch(' '); put_u(bad); say_end();                                       \
    }

SWEEP(uc, unsigned char, 8)
SWEEP(us, unsigned short, 16)
SWEEP(ui, unsigned int, 32)
SWEEP(ul, unsigned long, (unsigned)(sizeof(unsigned long) * 8))
SWEEP(ull, unsigned long long, 64)

/* One table row: the value and the fourteen answers, by the function of the suffix. */
 #define ROW(SUF, V)                                                                             \
    do {                                                                                          \
        put_u(V); say_raw(":", 1);                                                                \
        say_ch(' '); put_u(stdc_leading_zeros_##SUF(V));                                          \
        say_ch(' '); put_u(stdc_leading_ones_##SUF(V));                                           \
        say_ch(' '); put_u(stdc_trailing_zeros_##SUF(V));                                         \
        say_ch(' '); put_u(stdc_trailing_ones_##SUF(V));                                          \
        say_ch(' '); put_u(stdc_first_leading_zero_##SUF(V));                                     \
        say_ch(' '); put_u(stdc_first_leading_one_##SUF(V));                                      \
        say_ch(' '); put_u(stdc_first_trailing_zero_##SUF(V));                                    \
        say_ch(' '); put_u(stdc_first_trailing_one_##SUF(V));                                     \
        say_ch(' '); put_u(stdc_count_zeros_##SUF(V));                                            \
        say_ch(' '); put_u(stdc_count_ones_##SUF(V));                                             \
        say_ch(' '); put_u(stdc_has_single_bit_##SUF(V));                                         \
        say_ch(' '); put_u(stdc_bit_width_##SUF(V));                                              \
        say_ch(' '); put_u(stdc_bit_floor_##SUF(V));                                              \
        say_ch(' '); put_u(stdc_bit_ceil_##SUF(V));                                               \
        say_end();                                                                                \
    } while (0)
"""

@test("the macros: version, the two orders, and the native one")
stdbit_macros()
    c_case(raw"""
        say_int(__STDC_VERSION_STDBIT_H__);
        say_int(__STDC_ENDIAN_LITTLE__ != __STDC_ENDIAN_BIG__);
        say_int(__STDC_ENDIAN_NATIVE__ == __STDC_ENDIAN_LITTLE__ || __STDC_ENDIAN_NATIVE__ == __STDC_ENDIAN_BIG__);
        say_int(__STDC_ENDIAN_NATIVE__ == __STDC_ENDIAN_LITTLE__);
        #if __STDC_ENDIAN_NATIVE__ == __STDC_ENDIAN_LITTLE__
        say_str("little");
        #endif
        """, raw"""
        202311
        1
        1
        1
        little
        """, prelude)

@test("unsigned char: the edge values, worked out by hand")
stdbit_table_uc()
    c_case(raw"""
        ROW(uc, (unsigned char)0);
        ROW(uc, (unsigned char)1);
        ROW(uc, (unsigned char)0x80);
        ROW(uc, (unsigned char)0xff);
        ROW(uc, (unsigned char)0x7f);
        ROW(uc, (unsigned char)0x50);
        ROW(uc, (unsigned char)0xfe);
        ROW(uc, (unsigned char)0xa5);
        """, raw"""
        0: 8 0 8 0 1 0 1 0 8 0 0 0 0 1
        1: 7 0 0 1 1 8 2 1 7 1 1 1 1 1
        128: 0 1 7 0 2 1 1 8 7 1 1 8 128 128
        255: 0 8 0 8 0 1 0 1 0 8 0 8 128 0
        127: 1 0 0 7 1 2 8 1 1 7 0 7 64 128
        80: 1 0 4 0 1 2 1 5 6 2 0 7 64 128
        254: 0 7 1 0 8 1 1 2 1 7 0 8 128 0
        165: 0 1 0 1 2 1 2 1 4 4 0 8 128 0
        """, prelude)

@test("unsigned short: the edge values")
stdbit_table_us()
    c_case(raw"""
        ROW(us, (unsigned short)0);
        ROW(us, (unsigned short)0x8000);
        ROW(us, (unsigned short)0xffff);
        ROW(us, (unsigned short)0x0101);
        """, raw"""
        0: 16 0 16 0 1 0 1 0 16 0 0 0 0 1
        32768: 0 1 15 0 2 1 1 16 15 1 1 16 32768 32768
        65535: 0 16 0 16 0 1 0 1 0 16 0 16 32768 0
        257: 7 0 0 1 1 8 2 1 14 2 0 9 256 512
        """, prelude)

@test("unsigned int: the edge values")
stdbit_table_ui()
    c_case(raw"""
        ROW(ui, 0u);
        ROW(ui, 0x80000000u);
        ROW(ui, 0xffffffffu);
        ROW(ui, 0x80000001u);
        ROW(ui, 0x10000u);
        ROW(ui, 0x7fffffffu);
        ROW(ui, 0x40000001u);
        """, raw"""
        0: 32 0 32 0 1 0 1 0 32 0 0 0 0 1
        2147483648: 0 1 31 0 2 1 1 32 31 1 1 32 2147483648 2147483648
        4294967295: 0 32 0 32 0 1 0 1 0 32 0 32 2147483648 0
        2147483649: 0 1 0 1 2 1 2 1 30 2 0 32 2147483648 0
        65536: 15 0 16 0 1 16 1 17 31 1 1 17 65536 65536
        2147483647: 1 0 0 31 1 2 32 1 1 31 0 31 1073741824 2147483648
        1073741825: 1 0 0 1 1 2 2 1 30 2 0 31 1073741824 2147483648
        """, prelude)

@test("unsigned long long, and unsigned long on a 64-bit host: the edge values")
stdbit_table_wide()
    c_case(raw"""
        ROW(ull, 0ULL);
        ROW(ull, 1ULL << 63);
        ROW(ull, ~0ULL);
        ROW(ull, (1ULL << 63) + 1);
        ROW(ull, 1ULL << 32);
        ROW(ull, 0x7fffffffffffffffULL);
        ROW(ul, 0UL);
        ROW(ul, 1UL << 63);
        ROW(ul, ~0UL);
        """, raw"""
        0: 64 0 64 0 1 0 1 0 64 0 0 0 0 1
        9223372036854775808: 0 1 63 0 2 1 1 64 63 1 1 64 9223372036854775808 9223372036854775808
        18446744073709551615: 0 64 0 64 0 1 0 1 0 64 0 64 9223372036854775808 0
        9223372036854775809: 0 1 0 1 2 1 2 1 62 2 0 64 9223372036854775808 0
        4294967296: 31 0 32 0 1 32 1 33 63 1 1 33 4294967296 4294967296
        9223372036854775807: 1 0 0 63 1 2 64 1 1 63 0 63 4611686018427387904 9223372036854775808
        0: 64 0 64 0 1 0 1 0 64 0 0 0 0 1
        9223372036854775808: 0 1 63 0 2 1 1 64 63 1 1 64 9223372036854775808 9223372036854775808
        18446744073709551615: 0 64 0 64 0 1 0 1 0 64 0 64 9223372036854775808 0
        """, prelude)

@test("every unsigned char, and a spread of patterns at each wider width, against the bit-by-bit reference")
stdbit_sweeps()
    c_case(raw"""
        for (unsigned b = 0; b < 256; b++) {
            if (check_uc((unsigned char)b) != 0) { say_str("uc disagrees at"); say_uint(b); }
        }
        say_str("uc 256 values checked");
        sweep_uc();
        sweep_us();
        sweep_ui();
        sweep_ul();
        sweep_ull();
        """, raw"""
        uc 256 values checked
        1056 0
        1088 0
        1152 0
        1280 0
        1280 0
        """, prelude)

@test("bit_ceil of a value past the largest power of two answers 0, and 0 and 1 answer 1")
stdbit_bit_ceil_overflow()
    c_case(raw"""
        say_uint(stdc_bit_ceil_uc(0)); say_uint(stdc_bit_ceil_uc(1)); say_uint(stdc_bit_ceil_uc(2));
        say_uint(stdc_bit_ceil_uc(3)); say_uint(stdc_bit_ceil_uc(128)); say_uint(stdc_bit_ceil_uc(129));
        say_uint(stdc_bit_ceil_us(32769)); say_uint(stdc_bit_ceil_us(32768));
        say_uint(stdc_bit_ceil_ui(0x80000001u)); say_uint(stdc_bit_ceil_ui(0x80000000u));
        say_uint(stdc_bit_ceil_ull(0x8000000000000001ULL)); say_uint(stdc_bit_ceil_ull(~0ULL));
        say_uint(stdc_bit_ceil_ul(~0UL));
        """, raw"""
        1
        1
        2
        4
        128
        0
        0
        32768
        0
        2147483648
        0
        0
        0
        """, prelude)

@test("the type-generic macros answer in the types the standard gives, and evaluate the argument once")
stdbit_generic_types()
    c_case(raw"""
        #define TYPE_IS(expr, T) _Generic((expr), T: 1, default: 0)
        unsigned char c = 5; unsigned short s = 5; unsigned long long ll = 5;
        say_int(TYPE_IS(stdc_count_ones(c), unsigned int));
        say_int(TYPE_IS(stdc_leading_zeros(ll), unsigned int));
        say_int(TYPE_IS(stdc_bit_width(s), unsigned int));
        say_int(TYPE_IS(stdc_has_single_bit(c), _Bool));
        say_int(TYPE_IS(stdc_bit_floor(c), unsigned char));
        say_int(TYPE_IS(stdc_bit_floor(s), unsigned short));
        say_int(TYPE_IS(stdc_bit_ceil(5u), unsigned int));
        say_int(TYPE_IS(stdc_bit_ceil(5UL), unsigned long));
        say_int(TYPE_IS(stdc_bit_ceil(ll), unsigned long long));
        unsigned int n = 7;
        say_uint(stdc_count_ones(n++));
        say_uint(n);
        say_uint(stdc_bit_ceil(c));
        say_uint(stdc_bit_floor(ll));
        """, raw"""
        1
        1
        1
        1
        1
        1
        1
        1
        1
        3
        8
        8
        4
        """, prelude)
