// log(x) as hi + tail, the tail carrying about 15 more bits. `ix` is x's bits, a subnormal
// normalized with its exponent gone negative. `log_dd` (`math_dd.sysl`) uses it too.
private[cstd] pow_log(ix: u64) -> (real, real)
    // x = 2^k z, z in [OFF, 2 OFF) exact, in the ith subinterval around c.
    val tmp = ix - pow_off
    val i = (tmp >> (52 - pow_log_table_bits)) % 128
    val k = i64(tmp) >> 52
    val iz = ix - (tmp & (0xfffu64 << 52))
    val z = real.from_bits(iz)
    val kd = real(k)

    // log(x) = k ln2 + log(c) + log1p(z/c - 1).
    val invc = real.from_bits(pow_tab[3 * i])
    val logc = real.from_bits(pow_tab[3 * i + 1])
    val logctail = real.from_bits(pow_tab[3 * i + 2])

    // z split so that rhi, rlo and rhi × rhi are exact and |rlo| <= |r|.
    val zhi = real.from_bits((iz + (1u64 << 31)) & 0xffffffff00000000)
    val zlo = z - zhi
    val rhi = zhi * invc - 1.0
    val rlo = zlo * invc
    val r = rhi + rlo

    // k ln2 + log(c) + r.
    val t1 = kd * pow_ln2hi + logc
    val t2 = t1 + r
    val lo1 = kd * pow_ln2lo + logctail
    val lo2 = t1 - t2 + r

    // ... + A[0] r².
    val ar = pow_a0 * r
    val ar2 = r * ar
    val ar3 = r * ar2
    val arhi = pow_a0 * rhi
    val arhi2 = rhi * arhi
    val hi = t2 + arhi2
    val lo3 = rlo * (ar + arhi)
    val lo4 = t2 - hi + arhi2
    // p = log1p(r) - r - A[0] r².
    val p = ar3 * (pow_a1 + r * pow_a2 + ar2 * (pow_a3 + r * pow_a4 + ar2 * (pow_a5 + r * pow_a6)))
    val lo = lo1 + lo2 + lo3 + lo4 + p
    val y = hi + lo
    (y, hi - y + lo)
end pow_log

// scale × (1 + tmp) where it may overflow or underflow, as `exp_special`, with a sign carried in
// scale's bits.
private pow_special(tmp: real, sbits_in: u64, ki: u64) -> real
    var sbits = sbits_in
    if ki & 0x80000000 == 0
        // k > 0: the exponent of scale may have overflowed by up to 460.
        sbits -= 1009u64 << 52
        val scale = real.from_bits(sbits)
        return checked_overflow(5.486124068793689e303 * (scale + scale * tmp))
    // k < 0: care in the subnormal range.
    sbits += 1022u64 << 52
    val scale = real.from_bits(sbits)
    var y = scale + scale * tmp
    if fabs(y) < 1.0
        val one = if y < 0.0 then -1.0 else 1.0
        var lo = scale - y + scale * tmp
        val hi = one + y
        lo = one - hi + y + lo
        y = (hi + lo) - one
        // The sign of a zero.
        if y == 0.0 then y = real.from_bits(sbits & 0x8000000000000000)
    2.2250738585072014e-308 * y
end pow_special

// The sign bit of the exponent table's index, which sets the result negative.
private val sign_bias: u64 = 0x800 << 7

// sign × exp(x + xtail), with |xtail| < 2^-8/N and |xtail| <= |x|.
private pow_exp(x: real, xtail: real, bias: u64) -> real
    var abstop = top12(x) & 0x7ff
    if abstop - 0x3c9 >= 0x408 - 0x3c9
        if abstop - 0x3c9 >= 0x80000000
            // Tiny x.
            val one = 1.0 + x
            return if bias != 0 then -one else one
        if abstop >= 0x409
            // Infinities and NaNs were dealt with before this.
            if x.bits() >> 63 != 0 then return underflow(bias != 0)
            return overflow(bias != 0)
        abstop = 0

    // exp(x) = 2^(k/N) × exp(r), x = ln2/N × k + r.
    val z = exp_invln2n * x
    var kd = z + exp_shift
    val ki = kd.bits()
    kd -= exp_shift
    var r = x + kd * exp_negln2hin + kd * exp_negln2lon
    r += xtail
    val idx = 2 * (ki % exp_n)
    val top = (ki + bias) << (52 - exp_table_bits)
    val tail = real.from_bits(exp_tab[idx])
    val sbits = exp_tab[idx + 1] + top
    val r2 = r * r
    val tmp = tail + r + r2 * (exp_c2 + r * exp_c3) + r2 * r2 * (exp_c4 + r * exp_c5)
    if abstop == 0 then return pow_special(tmp, sbits, ki)
    val scale = real.from_bits(sbits)
    scale + scale * tmp
end pow_exp

// 0 when y is not an integer, 1 when it is odd, 2 when even, for the bits of a finite nonzero y.
private checkint(iy: u64) -> i32
    val e = i32((iy >> 52) & 0x7ff)
    if e < 0x3ff then return 0
    if e > 0x3ff + 52 then return 2
    if iy & ((1u64 << (0x3ff + 52 - e)) - 1) != 0 then return 0
    if iy & (1u64 << (0x3ff + 52 - e)) != 0 then return 1
    2

// Whether these are the bits of a zero, an infinity or a NaN.
private zeroinfnan(i: u64) -> bool = 2 * i - 1 >= 2 * 0x7ff0000000000000u64 - 1

@export("pow")
pow(x: real, y: real) -> real
    var bias: u64 = 0
    var ix = x.bits()
    val iy = y.bits()
    var topx = top12(x)
    val topy = top12(y)
    if topx - 0x001 >= 0x7ff - 0x001 || (topy & 0x7ff) - 0x3be >= 0x43e - 0x3be
        // x below 2^-1022, infinite or NaN; or |y| below 2^-65, at least 2^63, or NaN. Past
        // |y| = 1075 ln2 2^53 the answer is an infinity or zero, and below 2^-54/1075 it is ±1.
        if zeroinfnan(iy)
            if 2 * iy == 0 then return 1.0
            if ix == 0x3ff0000000000000 then return 1.0
            if 2 * ix > 2 * 0x7ff0000000000000u64 || 2 * iy > 2 * 0x7ff0000000000000u64 then return x + y
            if 2 * ix == 2 * 0x3ff0000000000000u64 then return 1.0
            // |x| < 1 with y = inf, or |x| > 1 with y = -inf.
            if (2 * ix < 2 * 0x3ff0000000000000u64) == (iy >> 63 == 0) then return 0.0
            return y * y
        if zeroinfnan(ix)
            var x2 = x * x
            if ix >> 63 != 0 && checkint(iy) == 1 then x2 = -x2
            if iy >> 63 == 0 then return x2
            // A zero to a negative power is a pole.
            if x2 == 0.0 then return pole_error(sign_bit(x2))
            return 1.0 / x2
        // x and y are nonzero and finite.
        if ix >> 63 != 0
            // A negative x needs an integer y.
            val yint = checkint(iy)
            if yint == 0 then return domain_error(x)
            if yint == 1 then bias = sign_bias
            ix = ix & 0x7fffffffffffffff
            topx = topx & 0x7ff
        if (topy & 0x7ff) - 0x3be >= 0x43e - 0x3be
            // bias is 0 here, since y is not odd.
            if ix == 0x3ff0000000000000 then return 1.0
            if (topy & 0x7ff) < 0x3be
                // |y| < 2^-65: x^y ~= 1 + y log(x).
                return if ix > 0x3ff0000000000000 then 1.0 + y else 1.0 - y
            if (ix > 0x3ff0000000000000) == (topy < 0x800) then return overflow(false)
            return underflow(false)
        if topx == 0
            // A subnormal x, normalized so that its exponent goes negative.
            ix = (x * 4503599627370496.0).bits()
            ix = ix & 0x7fffffffffffffff
            ix -= 52u64 << 52

    val (hi, lo) = pow_log(ix)
    // y × log(x) in two parts, |elo| < |ehi| 2^-25.
    val yhi = real.from_bits(iy & (0xffffffffffffffffu64 << 27))
    val ylo = y - yhi
    val lhi = real.from_bits(hi.bits() & (0xffffffffffffffffu64 << 27))
    val llo = hi - lhi + lo
    val ehi = yhi * lhi
    val elo = ylo * lhi + y * llo
    pow_exp(ehi, elo, bias)
end pow

@export("powf")
powf(x: f32, y: f32) -> f32 = narrow(pow(real(x), real(y)))
