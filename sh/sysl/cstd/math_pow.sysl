module sh.sysl.cstd

// `<math.h>`'s power function.
//
// Arm's optimized-routines as musl 1.2.6 carries them (`pow.c`, `pow_data.c`, MIT): log(x) to about
// 68 bits as a double and a tail, from a 128-entry table and a degree-seven polynomial; y × log(x)
// formed in two parts with the operands split so that the products are exact; and exp of that,
// sharing `exp`'s table. Within 0.54 ulp. The special cases are C Annex F's: pow(x, ±0) = 1 for any
// x, pow(1, y) = 1 for any y, pow(-1, ±inf) = 1, a negative x only with an integer y.
//
// The float form computes in double and rounds once.
//
// Copyright (c) 2018, Arm Limited. SPDX-License-Identifier: MIT.

private val pow_log_table_bits: u64 = 7
private val pow_off: u64 = 0x3fe6955500000000

private val pow_ln2hi: real = 0x1.62e42fefa3800p-1
private val pow_ln2lo: real = 0x1.ef35793c76730p-45

// log1p(r) on |r| < 0x1.6bp-8, relative error 0x1.11922ap-70, the coefficients scaled by the
// powers of -2 the evaluation divides out.
private val pow_a0: real = -0x1p-1
private val pow_a1: real = -0x1.5555555555560p-1  // musl's 0x1.555555555556p-2 × -2
private val pow_a2: real = 0x1.0000000000006p-1  // musl's -0x1.0000000000006p-2 × -2
private val pow_a3: real = 0x1.999999959554ep-1  // musl's 0x1.999999959554ep-3 × 4
private val pow_a4: real = -0x1.555555529a47ap-1  // musl's -0x1.555555529a47ap-3 × 4
private val pow_a5: real = -0x1.2495b9b4845e9p+0  // musl's 0x1.2495b9b4845e9p-3 × -8
private val pow_a6: real = 0x1.0002b8b263fc3p+0  // musl's -0x1.0002b8b263fc3p-3 × -8

