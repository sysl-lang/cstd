module sh.sysl.cstd

// `<math.h>`'s square root, correctly rounded.
//
// **Where the machine has the instruction, it is the instruction**: `llvm.sqrt` is AArch64's
// `fsqrt` and x86-64's `sqrtsd`, both correctly rounded by IEEE 754. Elsewhere -- a Cortex-M with
// no double-precision unit, RISC-V -- `llvm.sqrt` would lower to a call to `sqrt`, which is this
// function, so there the root is computed in integer arithmetic: musl's `sqrt.c`, a reciprocal
// square root estimate from a 128-entry table refined by two Goldschmidt steps in 32 bits and one in
// 64, then the last bit decided exactly by squaring. `soft_sqrt` is compiled on every machine, so
// the host's tests hold it to the instruction.
//
// The float root is the double root rounded once: double has more than twice float's precision
// plus two bits, so rounding twice gives the correctly rounded float (Figueroa, 1995).

#if aarch64 || x86_64
private extern "llvm.sqrt" machine_sqrt(x: real) -> real

@export("sqrt")
sqrt(x: real) -> real
    if x < 0.0 then return domain_error(x)
    machine_sqrt(x)
#else
@export("sqrt")
sqrt(x: real) -> real = soft_sqrt(x)
#endif

@export("sqrtf")
sqrtf(x: f32) -> f32 = f32(sqrt(real(x)))

// --- cbrt: musl's `cbrt.c` (FreeBSD's, optimized by Bruce D. Evans): 5 bits from dividing the
// exponent's bits by 3, 23 from a polynomial, then t rounded to 23 bits so that t² is exact and one
// Newton step. Within 0.667 ulp. From fdlibm, whose terms ask that its notice be kept with the code:
//
//     Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//     Developed at SunPro, a Sun Microsystems, Inc. business.
//     Permission to use, copy, modify, and distribute this software is freely granted,
//     provided that this notice is preserved. ---

private val cbrt_b1: u32 = 715094163  // (1023 - 1023/3 - 0.03306235651) × 2^20
private val cbrt_b2: u32 = 696219795  // (1023 - 1023/3 - 54/3 - 0.03306235651) × 2^20
private val cbrt_p0: real = 1.87595182427177009643    // 0x3ffe03e6 0x0f61e692
private val cbrt_p1: real = -1.88497979543377169875   // 0xbffe28e0 0x92f02420
private val cbrt_p2: real = 1.621429720105354466140   // 0x3ff9f160 0x4a49d6c2
private val cbrt_p3: real = -0.758397934778766047437  // 0xbfe844cb 0xbee751d9
private val cbrt_p4: real = 0.145996192886612446982   // 0x3fc2b000 0xd4e4edd7

@export("cbrt")
cbrt(x: real) -> real
    var hx = hi_word(x) & 0x7fffffff
    // cbrt of a NaN or an infinity is itself.
    if hx >= 0x7ff00000 then return x + x
    // Rough cbrt to 5 bits: cbrt(2^e (1 + m)) ~= 2^(e/3) (1 + (e%3 + m)/3), which the integer
    // division of the bits gives almost exactly once the exponent bias is taken out and put back.
    if hx < 0x00100000
        // Zero or subnormal.
        hx = hi_word(x * 18014398509481984.0) & 0x7fffffff
        if hx == 0 then return x
        hx = hx / 3 + cbrt_b2
    else
        hx = hx / 3 + cbrt_b1
    var t = real.from_bits((x.bits() & (1u64 << 63)) | (u64(hx) << 32))

    // To 23 bits: cbrt(x) = t cbrt(x/t³) ~= t P(t³/x), P approximating 1/cbrt(r) to 2^-23.5 for
    // |r - 1| < 1/10.
    var r = (t * t) * (t / x)
    t = t * ((cbrt_p0 + r * (cbrt_p1 + r * cbrt_p2)) + ((r * r) * r) * (cbrt_p3 + r * cbrt_p4))

    // t rounded away from zero to 23 bits, so that t² is exact and t is above cbrt(x) by at most
    // two 23-bit units.
    t = real.from_bits((t.bits() + 0x80000000) & 0xffffffffc0000000)

    // One Newton step to 53 bits, error below 0.667 ulp.
    val s = t * t
    r = x / s
    val w = t + t
    r = (r - t) / (w + r)
    t + t * r
end cbrt

@export("cbrtf")
cbrtf(x: f32) -> f32 = f32(cbrt(real(x)))

// --- hypot: musl's `hypot.c`: the two squares each exact as hi + lo, summed and rooted once,
// scaled by 2^±700 where a square would overflow or lose bits. ---

// x² as hi + lo, x split at 2^27 + 1.
private sq(x: real) -> (real, real)
    val xc = x * 134217729.0
    val xh = x - xc + xc
    val xl = x - xh
    val hi = x * x
    (hi, xh * xh - hi + 2.0 * xh * xl + xl * xl)

@export("hypot")
hypot(x_in: real, y_in: real) -> real
    var ux = x_in.bits() & 0x7fffffffffffffff
    var uy = y_in.bits() & 0x7fffffffffffffff
    // |x| >= |y|
    if ux < uy
        val t = ux
        ux = uy
        uy = t
    val ex = i32(ux >> 52)
    val ey = i32(uy >> 52)
    var x = real.from_bits(ux)
    var y = real.from_bits(uy)
    // hypot(inf, NaN) is inf.
    if ey == 0x7ff then return y
    if ex == 0x7ff || uy == 0 then return x
    // hypot(x, y) ~= x + y²/2x for a small y/x.
    if ex - ey > 64 then return x + y

    // A precise argument for the root, without overflow: neither xh² may overflow nor xl²
    // underflow.
    var z = 1.0
    if ex > 0x3ff + 510
        z = 5.260135901548374e210
        x = x * 1.90109156629516e-211
        y = y * 1.90109156629516e-211
    elif ey < 0x3ff - 450
        z = 1.90109156629516e-211
        x = x * 5.260135901548374e210
        y = y * 5.260135901548374e210
    val (hx, lx) = sq(x)
    val (hy, ly) = sq(y)
    checked_overflow(z * sqrt(ly + lx + hy + hx))
end hypot

// The float hypot is musl's too: the squares are exact in double, so the double root rounded once.
@export("hypotf")
hypotf(x: f32, y: f32) -> f32
    val ax = fabsf(x)
    val ay = fabsf(y)
    if ax == f32.infinity || ay == f32.infinity then return f32.infinity
    if ax != ax || ay != ay then return ax + ay
    narrow(sqrt(real(ax) * real(ax) + real(ay) * real(ay)))

// musl's `__rsqrt_tab`: 1/sqrt(m) to 16 bits for the 128 leading bits of m in [1, 4).
private val rsqrt_tab: [128]u16 = [
    0xb451, 0xb2f0, 0xb196, 0xb044, 0xaef9, 0xadb6, 0xac79, 0xab43,
    0xaa14, 0xa8eb, 0xa7c8, 0xa6aa, 0xa592, 0xa480, 0xa373, 0xa26b,
    0xa168, 0xa06a, 0x9f70, 0x9e7b, 0x9d8a, 0x9c9d, 0x9bb5, 0x9ad1,
    0x99f0, 0x9913, 0x983a, 0x9765, 0x9693, 0x95c4, 0x94f8, 0x9430,
    0x936b, 0x92a9, 0x91ea, 0x912e, 0x9075, 0x8fbe, 0x8f0a, 0x8e59,
    0x8daa, 0x8cfe, 0x8c54, 0x8bac, 0x8b07, 0x8a64, 0x89c4, 0x8925,
    0x8889, 0x87ee, 0x8756, 0x86c0, 0x862b, 0x8599, 0x8508, 0x8479,
    0x83ec, 0x8361, 0x82d8, 0x8250, 0x81c9, 0x8145, 0x80c2, 0x8040,
    0xff02, 0xfd0e, 0xfb25, 0xf947, 0xf773, 0xf5aa, 0xf3ea, 0xf234,
    0xf087, 0xeee3, 0xed47, 0xebb3, 0xea27, 0xe8a3, 0xe727, 0xe5b2,
    0xe443, 0xe2dc, 0xe17a, 0xe020, 0xdecb, 0xdd7d, 0xdc34, 0xdaf1,
    0xd9b3, 0xd87b, 0xd748, 0xd61a, 0xd4f1, 0xd3cd, 0xd2ad, 0xd192,
    0xd07b, 0xcf69, 0xce5b, 0xcd51, 0xcc4a, 0xcb48, 0xca4a, 0xc94f,
    0xc858, 0xc764, 0xc674, 0xc587, 0xc49d, 0xc3b7, 0xc2d4, 0xc1f4,
    0xc116, 0xc03c, 0xbf65, 0xbe90, 0xbdbe, 0xbcef, 0xbc23, 0xbb59,
    0xba91, 0xb9cc, 0xb90a, 0xb84a, 0xb78c, 0xb6d0, 0xb617, 0xb560,
]

// a × b × 2^-32, less an error in [0, 1).
private mul32(a: u64, b: u64) -> u64 = ((a & 0xffffffff) * (b & 0xffffffff)) >> 32

// Doubled in 32 bits, as musl's `uint32_t` result of `mul32` is shifted.
private twice32(a: u64) -> u64 = (a << 1) & 0xffffffff

// a × b × 2^-64, less an error in [0, 3).
private mul64(a: u64, b: u64) -> u64
    val ahi = a >> 32
    val alo = a & 0xffffffff
    val bhi = b >> 32
    val blo = b & 0xffffffff
    ahi * bhi + ((ahi * blo) >> 32) + ((alo * bhi) >> 32)

private[cstd] soft_sqrt(x: real) -> real
    var ix = x.bits()
    var top = ix >> 52
    if top -% 1 >= 0x7ff - 1
        // Below 2^-1022, or infinite, or NaN.
        if ix *% 2 == 0 then return x
        if ix == 0x7ff0000000000000 then return x
        if ix > 0x7ff0000000000000 then return domain_error(x)
        // A subnormal, made normal by 2^52.
        ix = (x * 4503599627370496.0).bits()
        top = (ix >> 52) -% 52

    // x = 4^e m, with m in [1, 4) as fixed point 2.62; 2^e is the result's exponent.
    val even = top & 1
    var m = (ix << 11) | 0x8000000000000000
    if even != 0 then m = m >> 1
    top = (top +% 0x3ff) >> 1

    // r ~ 1/sqrt(m) and s ~ sqrt(m): a table estimate, two Goldschmidt iterations in 32-bit fixed
    // point (m 2.30, r 0.32, s 2.30), and a last one in 64 (m 2.62, r 0.64, s 2.62).
    val three: u64 = 0xc0000000
    val i = (ix >> 46) % 128
    var r = u64(rsqrt_tab[i]) << 16
    var s = mul32(m >> 32, r)
    var d = mul32(s, r)
    var u = three -% d
    r = twice32(mul32(r, u))
    s = twice32(mul32(s, u))
    d = mul32(s, r)
    u = three -% d
    r = twice32(mul32(r, u))
    r = r << 32
    s = mul64(m, r)
    d = mul64(s, r)
    u = (three << 32) -% d
    s = mul64(s, u)
    // -2^-52 × 1.03 < s - sqrt(m) < 0, as 12.52 fixed point.
    s = (s -% 2) >> 9

    // The nearest result is s or s + 2^-52: compare (2^52 s + 0.5)^2 with 2^104 m.
    val d0 = (m << 42) -% s *% s
    val d1 = s -% d0
    s = s +% (d1 >> 63)
    s = s & 0x000fffffffffffff
    s = s | (top << 52)
    real.from_bits(s)
end soft_sqrt
