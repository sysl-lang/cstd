module sh.sysl.cstd

// `<string.h>`: the byte and C-string functions, over raw pointers because that is what their C
// signatures are.
//
// **Every function is an ordinary sysl function of this module, exported under its C name.** The
// export is what a C program's `strlen` call resolves to. On a freestanding target there is no other
// libc to meet; on the host, where the tests run, a C program linked against this archive takes
// these definitions ahead of the system's, so what a test observes is this library.
//
// A C `char *` is a `*u8` and a `void *` is a `*u8` too: the ABI is one pointer either way, and the
// header in `include/` carries the `const` and the `void` C wants to see. Bytes are compared as
// `unsigned char`, as C requires of `strcmp` and `memcmp`.

import sysl.slices.as_ptr

@export("strlen")
strlen(s: *u8) -> usize
    var n: usize = 0
    while s[n] != 0 do n += 1
    n

@export("strcmp")
strcmp(a: *u8, b: *u8) -> i32
    var i: usize = 0
    while a[i] != 0 && a[i] == b[i] do i += 1
    i32(a[i]) - i32(b[i])

@export("strncmp")
strncmp(a: *u8, b: *u8, n: usize) -> i32
    for i in 0..<n
        if a[i] != b[i] then return i32(a[i]) - i32(b[i])
        if a[i] == 0 then return 0
    0

@export("strcpy")
strcpy(dst: *u8, src: *u8) -> *u8
    var i: usize = 0
    loop
        dst[i] = src[i]
        if src[i] == 0 then break
        i += 1
    dst

// Copies at most `n` bytes and fills the rest of the `n` with zeros — and, as C specifies, leaves
// `dst` unterminated when `src` is `n` bytes or longer.
@export("strncpy")
strncpy(dst: *u8, src: *u8, n: usize) -> *u8
    var i: usize = 0
    while i < n && src[i] != 0
        dst[i] = src[i]
        i += 1
    while i < n
        dst[i] = 0
        i += 1
    dst

@export("strcat")
strcat(dst: *u8, src: *u8) -> *u8
    strcpy(&dst[strlen(dst)], src)
    dst

// Appends at most `n` bytes of `src` and always terminates, so `dst` needs `n + 1` bytes free.
@export("strncat")
strncat(dst: *u8, src: *u8, n: usize) -> *u8
    val end = &dst[strlen(dst)]
    var i: usize = 0
    while i < n && src[i] != 0
        end[i] = src[i]
        i += 1
    end[i] = 0
    dst

// The terminator is part of the string here: `strchr(s, 0)` answers the address of the zero.
@export("strchr")
strchr(s: *u8, c: i32) -> *u8
    val want = u8(c)
    var i: usize = 0
    loop
        if s[i] == want then return &s[i]
        if s[i] == 0 then return null
        i += 1

@export("strrchr")
strrchr(s: *u8, c: i32) -> *u8
    val want = u8(c)
    var last: *u8 = null
    var i: usize = 0
    loop
        if s[i] == want then last = &s[i]
        if s[i] == 0 then return last
        i += 1

// An empty needle is found at the start of any haystack, the empty one included.
@export("strstr")
strstr(haystack: *u8, needle: *u8) -> *u8
    val n = strlen(needle)
    var i: usize = 0
    loop
        if strncmp(&haystack[i], needle, n) == 0 then return &haystack[i]
        if haystack[i] == 0 then return null
        i += 1

// Whether byte `b` is one of the bytes of the C string `set`. The terminator never is.
private in_set(b: u8, set: *u8) -> bool
    var i: usize = 0
    while set[i] != 0
        if set[i] == b then return true
        i += 1
    false

@export("strspn")
strspn(s: *u8, accept: *u8) -> usize
    var n: usize = 0
    while s[n] != 0 && in_set(s[n], accept) do n += 1
    n

@export("strcspn")
strcspn(s: *u8, reject: *u8) -> usize
    var n: usize = 0
    while s[n] != 0 && !in_set(s[n], reject) do n += 1
    n

@export("strpbrk")
strpbrk(s: *u8, accept: *u8) -> *u8
    val at = &s[strcspn(s, accept)]
    if at[0] == 0 then null else at

// The reentrant tokenizer. `save` holds where the next call resumes, so a caller passes `null` for
// `s` on every call after the first; a token is terminated in place by overwriting its delimiter.
@export("strtok_r")
strtok_r(s: *u8, delim: *u8, save: **u8) -> *u8
    var from = if s != null then s else *save
    if from == null then return null
    from = &from[strspn(from, delim)]
    if from[0] == 0
        *save = null
        return null
    val len = strcspn(from, delim)
    if from[len] == 0
        *save = null
    else
        from[len] = 0
        *save = &from[len + 1]
    from

@export("memcpy")
memcpy(dst: *u8, src: *u8, n: usize) -> *u8
    for i in 0..<n do dst[i] = src[i]
    dst

// Overlap is allowed, so the copy runs backwards exactly when `dst` starts inside `src`'s bytes —
// the one case where a forward copy would overwrite a byte before reading it.
@export("memmove")
memmove(dst: *u8, src: *u8, n: usize) -> *u8
    val gap = dst - src
    if gap > 0 && usize(gap) < n
        var i = n
        while i > 0
            i -= 1
            dst[i] = src[i]
    else
        for i in 0..<n do dst[i] = src[i]
    dst

@export("memset")
memset(dst: *u8, c: i32, n: usize) -> *u8
    val b = u8(c)
    for i in 0..<n do dst[i] = b
    dst

@export("memcmp")
memcmp(a: *u8, b: *u8, n: usize) -> i32
    for i in 0..<n
        if a[i] != b[i] then return i32(a[i]) - i32(b[i])
    0

@export("memchr")
memchr(s: *u8, c: i32, n: usize) -> *u8
    val want = u8(c)
    for i in 0..<n
        if s[i] == want then return &s[i]
    null

// Like `strlen`, but never looks past `n` bytes, so a buffer that is not terminated is safe.
@export("strnlen")
strnlen(s: *u8, n: usize) -> usize
    var i: usize = 0
    while i < n && s[i] != 0 do i += 1
    i

// Where `strtok` resumes. One for the whole program, as C has it; `strtok_r` is the call for code
// that tokenizes from two places at once.
private var strtok_save: *u8 = null

@export("strtok")
strtok(s: *u8, delim: *u8) -> *u8 = strtok_r(s, delim, &strtok_save)

// The message for an errno value: `Success` for 0 and one line for each code `errno.sysl` defines,
// in glibc's words. Any other number gets the fixed text `Unknown error`, without the number — a C
// library would format it in, and nothing here may depend on a formatter. Every message is a
// literal, so the pointer is to text that ends in a NUL and lives as long as the program.
@export("strerror")
strerror(code: i32) -> *u8 = as_ptr(message(code).bytes)

private message(code: i32) -> string = code match
    0 -> "Success"
    EPERM -> "Operation not permitted"
    ENOENT -> "No such file or directory"
    ESRCH -> "No such process"
    EINTR -> "Interrupted system call"
    EIO -> "Input/output error"
    ENXIO -> "No such device or address"
    E2BIG -> "Argument list too long"
    ENOEXEC -> "Exec format error"
    EBADF -> "Bad file descriptor"
    ECHILD -> "No child processes"
    EAGAIN -> "Resource temporarily unavailable"
    ENOMEM -> "Cannot allocate memory"
    EACCES -> "Permission denied"
    EFAULT -> "Bad address"
    ENOTBLK -> "Block device required"
    EBUSY -> "Device or resource busy"
    EEXIST -> "File exists"
    EXDEV -> "Invalid cross-device link"
    ENODEV -> "No such device"
    ENOTDIR -> "Not a directory"
    EISDIR -> "Is a directory"
    EINVAL -> "Invalid argument"
    ENFILE -> "Too many open files in system"
    EMFILE -> "Too many open files"
    ENOTTY -> "Inappropriate ioctl for device"
    ETXTBSY -> "Text file busy"
    EFBIG -> "File too large"
    ENOSPC -> "No space left on device"
    ESPIPE -> "Illegal seek"
    EROFS -> "Read-only file system"
    EMLINK -> "Too many links"
    EPIPE -> "Broken pipe"
    EDOM -> "Numerical argument out of domain"
    ERANGE -> "Numerical result out of range"
    EDEADLK -> "Resource deadlock avoided"
    ENAMETOOLONG -> "File name too long"
    ENOLCK -> "No locks available"
    ENOSYS -> "Function not implemented"
    ENOTEMPTY -> "Directory not empty"
    ELOOP -> "Too many levels of symbolic links"
    EOVERFLOW -> "Value too large for defined data type"
    EILSEQ -> "Invalid or incomplete multibyte or wide character"
    ENOTSOCK -> "Socket operation on non-socket"
    EDESTADDRREQ -> "Destination address required"
    EOPNOTSUPP -> "Operation not supported"
    EAFNOSUPPORT -> "Address family not supported by protocol"
    ETIMEDOUT -> "Connection timed out"
    _ -> UNKNOWN_ERROR

private val UNKNOWN_ERROR: string = "Unknown error"

// The reentrant `strerror`: the same message, copied into the caller's buffer. A message that does
// not fit is cut to what does, still terminated, and the answer is `ERANGE`; a code `errno.h` does not
// define gets `Unknown error` and the answer `EINVAL`, as the standard's rationale suggests. `errno`
// is left alone, since the answer carries the error.
@export("strerror_r")
strerror_r(code: i32, buf: *u8, size: usize) -> i32
    val text = message(code)
    if strlcpy(buf, as_ptr(text.bytes), size) >= size then return ERANGE
    if text == UNKNOWN_ERROR then EINVAL else 0

// Only the C locale exists, so the locale changes nothing and the message is `strerror`'s.
@export("strerror_l")
strerror_l(code: i32, locale: *u8) -> *u8 = strerror(code)

// The text for a signal number: one for each signal `signal.h` defines, in glibc's words, and the
// fixed text `Unknown signal` for any other number. POSIX leaves the words to the implementation.
@export("strsignal")
strsignal(sig: i32) -> *u8 = as_ptr(signal_text(sig).bytes)

// The numbers are `signal.h`'s, which are Linux's.
private signal_text(sig: i32) -> string = sig match
    1 -> "Hangup"
    2 -> "Interrupt"
    3 -> "Quit"
    4 -> "Illegal instruction"
    5 -> "Trace/breakpoint trap"
    6 -> "Aborted"
    7 -> "Bus error"
    8 -> "Floating point exception"
    9 -> "Killed"
    10 -> "User defined signal 1"
    11 -> "Segmentation fault"
    12 -> "User defined signal 2"
    13 -> "Broken pipe"
    14 -> "Alarm clock"
    15 -> "Terminated"
    17 -> "Child exited"
    _ -> "Unknown signal"

// `strcpy` that answers the address of the terminator it wrote, so a chain of copies never has to
// find the end again.
@export("stpcpy")
stpcpy(dst: *u8, src: *u8) -> *u8
    var i: usize = 0
    loop
        dst[i] = src[i]
        if src[i] == 0 then return &dst[i]
        i += 1

// `strncpy` that answers where the copy ended: the first NUL it padded with, or `&dst[n]` when `src`
// filled all `n` bytes and left `dst` unterminated.
@export("stpncpy")
stpncpy(dst: *u8, src: *u8, n: usize) -> *u8
    var i: usize = 0
    while i < n && src[i] != 0
        dst[i] = src[i]
        i += 1
    val end = &dst[i]
    while i < n
        dst[i] = 0
        i += 1
    end

// Copies as much of `src` as fits in `size` bytes and terminates it, unless `size` is 0, when nothing
// is written. The answer is the whole length of `src`, so an answer of `size` or more says the copy
// was cut short.
@export("strlcpy")
strlcpy(dst: *u8, src: *u8, size: usize) -> usize
    val len = strlen(src)
    if size > 0
        val n = if len < size then len else size - 1
        memcpy(dst, src, n)
        dst[n] = 0
    len

// Appends as much of `src` as fits in `dst`'s `size` bytes and terminates it. The answer is the
// length it tried to make, `strnlen(dst, size) + strlen(src)`. A `dst` with no NUL in its first
// `size` bytes is left exactly as it was.
@export("strlcat")
strlcat(dst: *u8, src: *u8, size: usize) -> usize
    val have = strnlen(dst, size)
    if have == size then return size + strlen(src)
    have + strlcpy(&dst[have], src, size - have)

// The first place the `nlen` bytes of `needle` occur in the `hlen` bytes of `haystack`. An empty
// needle is found at the start; a needle longer than the haystack is found nowhere.
@export("memmem")
memmem(haystack: *u8, hlen: usize, needle: *u8, nlen: usize) -> *u8
    if nlen == 0 then return haystack
    if hlen < nlen then return null
    val starts = hlen - nlen + 1
    for i in 0..<starts
        if memcmp(&haystack[i], needle, nlen) == 0 then return &haystack[i]
    null

// The program supplies `malloc`: the Linux half's, a board's, or the host's in the tests.
@needs(os)
private extern "malloc" c_malloc(n: usize) -> *u8

// A new string holding the `len` bytes at `s` and a terminator, or null with `ENOMEM` when the
// allocation fails. `errno` is set here because a board's `malloc` need not set it.
private duplicate(s: *u8, len: usize) -> *u8
    val copy = c_malloc(len + 1)
    if copy == null
        errno = ENOMEM
        return null
    memcpy(copy, s, len)
    copy[len] = 0
    copy

@export("strdup")
strdup(s: *u8) -> *u8 = duplicate(s, strlen(s))

// At most `size` bytes of `s`, terminated. It reads no further than `size` bytes, so `s` need not be
// terminated, and it allocates only what the copy needs.
@export("strndup")
strndup(s: *u8, size: usize) -> *u8 = duplicate(s, strnlen(s, size))

// Only the C locale exists, and its collating order is the order of the bytes as `unsigned char`, so
// collating is comparing and a transformed string is the string itself.
@export("strcoll")
strcoll(a: *u8, b: *u8) -> i32 = strcmp(a, b)

@export("strcoll_l")
strcoll_l(a: *u8, b: *u8, locale: *u8) -> i32 = strcmp(a, b)

// The transform of `src`, which in the C locale is `src`, copied with its terminator when it fits in
// `n` bytes. When it does not, `dst` is left untouched (the standard leaves it unspecified), so `dst`
// may be null when `n` is 0. The answer is the transform's length either way.
@export("strxfrm")
strxfrm(dst: *u8, src: *u8, n: usize) -> usize
    val len = strlen(src)
    if len < n then memcpy(dst, src, len + 1)
    len

@export("strxfrm_l")
strxfrm_l(dst: *u8, src: *u8, n: usize, locale: *u8) -> usize = strxfrm(dst, src, n)
