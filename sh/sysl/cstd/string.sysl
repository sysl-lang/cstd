module sh.sysl.cstd

// `<string.h>`: the byte and C-string functions, over raw pointers because that is what their C
// signatures are.
//
// **Every function is an ordinary sysl function of this module, exported under its C name.** The
// export is what a C program's `strlen` call resolves to. On a freestanding target there is no other
// libc to meet; on the host, where the tests run, a C program linked against this archive takes
// these definitions ahead of the system's, so what a test observes is this library.
//
// A C `char *` is a `*u8` and a `void *` is a `*u8` too: the ABI is one pointer either way, and the
// header in `include/` carries the `const` and the `void` C wants to see. Bytes are compared as
// `unsigned char`, as C requires of `strcmp` and `memcmp`.

import sysl.slices.as_ptr

@export("strlen")
strlen(s: *u8) -> usize
    var n: usize = 0
    while s[n] != 0 do n += 1
    n

@export("strcmp")
strcmp(a: *u8, b: *u8) -> i32
    var i: usize = 0
    while a[i] != 0 && a[i] == b[i] do i += 1
    i32(a[i]) - i32(b[i])

@export("strncmp")
strncmp(a: *u8, b: *u8, n: usize) -> i32
    for i in 0..<n
        if a[i] != b[i] then return i32(a[i]) - i32(b[i])
        if a[i] == 0 then return 0
    0

@export("strcpy")
strcpy(dst: *u8, src: *u8) -> *u8
    var i: usize = 0
    loop
        dst[i] = src[i]
        if src[i] == 0 then break
        i += 1
    dst

// Copies at most `n` bytes and fills the rest of the `n` with zeros — and, as C specifies, leaves
// `dst` unterminated when `src` is `n` bytes or longer.
@export("strncpy")
strncpy(dst: *u8, src: *u8, n: usize) -> *u8
    var i: usize = 0
    while i < n && src[i] != 0
        dst[i] = src[i]
        i += 1
    while i < n
        dst[i] = 0
        i += 1
    dst

@export("strcat")
strcat(dst: *u8, src: *u8) -> *u8
    strcpy(&dst[strlen(dst)], src)
    dst

// Appends at most `n` bytes of `src` and always terminates, so `dst` needs `n + 1` bytes free.
@export("strncat")
strncat(dst: *u8, src: *u8, n: usize) -> *u8
    val end = &dst[strlen(dst)]
    var i: usize = 0
    while i < n && src[i] != 0
        end[i] = src[i]
        i += 1
    end[i] = 0
    dst

// The terminator is part of the string here: `strchr(s, 0)` answers the address of the zero.
@export("strchr")
strchr(s: *u8, c: i32) -> *u8
    val want = u8(c)
    var i: usize = 0
    loop
        if s[i] == want then return &s[i]
        if s[i] == 0 then return null
        i += 1

@export("strrchr")
strrchr(s: *u8, c: i32) -> *u8
    val want = u8(c)
    var last: *u8 = null
    var i: usize = 0
    loop
        if s[i] == want then last = &s[i]
        if s[i] == 0 then return last
        i += 1

// An empty needle is found at the start of any haystack, the empty one included.
@export("strstr")
strstr(haystack: *u8, needle: *u8) -> *u8
    val n = strlen(needle)
    var i: usize = 0
    loop
        if strncmp(&haystack[i], needle, n) == 0 then return &haystack[i]
        if haystack[i] == 0 then return null
        i += 1

// Whether byte `b` is one of the bytes of the C string `set`. The terminator never is.
private in_set(b: u8, set: *u8) -> bool
    var i: usize = 0
    while set[i] != 0
        if set[i] == b then return true
        i += 1
    false

@export("strspn")
strspn(s: *u8, accept: *u8) -> usize
    var n: usize = 0
    while s[n] != 0 && in_set(s[n], accept) do n += 1
    n

@export("strcspn")
strcspn(s: *u8, reject: *u8) -> usize
    var n: usize = 0
    while s[n] != 0 && !in_set(s[n], reject) do n += 1
    n

@export("strpbrk")
strpbrk(s: *u8, accept: *u8) -> *u8
    val at = &s[strcspn(s, accept)]
    if at[0] == 0 then null else at

// The reentrant tokenizer. `save` holds where the next call resumes, so a caller passes `null` for
// `s` on every call after the first; a token is terminated in place by overwriting its delimiter.
@export("strtok_r")
strtok_r(s: *u8, delim: *u8, save: **u8) -> *u8
    var from = if s != null then s else *save
    if from == null then return null
    from = &from[strspn(from, delim)]
    if from[0] == 0
        *save = null
        return null
    val len = strcspn(from, delim)
    if from[len] == 0
        *save = null
    else
        from[len] = 0
        *save = &from[len + 1]
    from

@export("memcpy")
memcpy(dst: *u8, src: *u8, n: usize) -> *u8
    for i in 0..<n do dst[i] = src[i]
    dst

// Overlap is allowed, so the copy runs backwards exactly when `dst` starts inside `src`'s bytes —
// the one case where a forward copy would overwrite a byte before reading it.
@export("memmove")
memmove(dst: *u8, src: *u8, n: usize) -> *u8
    val gap = dst - src
    if gap > 0 && usize(gap) < n
        var i = n
        while i > 0
            i -= 1
            dst[i] = src[i]
    else
        for i in 0..<n do dst[i] = src[i]
    dst

@export("memset")
memset(dst: *u8, c: i32, n: usize) -> *u8
    val b = u8(c)
    for i in 0..<n do dst[i] = b
    dst

@export("memcmp")
memcmp(a: *u8, b: *u8, n: usize) -> i32
    for i in 0..<n
        if a[i] != b[i] then return i32(a[i]) - i32(b[i])
    0

@export("memchr")
memchr(s: *u8, c: i32, n: usize) -> *u8
    val want = u8(c)
    for i in 0..<n
        if s[i] == want then return &s[i]
    null

// Like `strlen`, but never looks past `n` bytes, so a buffer that is not terminated is safe.
@export("strnlen")
strnlen(s: *u8, n: usize) -> usize
    var i: usize = 0
    while i < n && s[i] != 0 do i += 1
    i

// Where `strtok` resumes. One for the whole program, as C has it; `strtok_r` is the call for code
// that tokenizes from two places at once.
private var strtok_save: *u8 = null

@export("strtok")
strtok(s: *u8, delim: *u8) -> *u8 = strtok_r(s, delim, &strtok_save)

// The message for an errno value: `Success` for 0 and one line for each code `errno.sysl` defines.
// Any other number gets the fixed text `Unknown error`, without the number — a C library would
// format it in, and nothing here may depend on a formatter.
@export("strerror")
strerror(code: i32) -> *u8
    if code == 0 then return as_ptr("Success".bytes)
    if code == EINVAL then return as_ptr("Invalid argument".bytes)
    if code == ERANGE then return as_ptr("Numerical result out of range".bytes)
    as_ptr("Unknown error".bytes)
