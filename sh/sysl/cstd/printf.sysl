module sh.sysl.cstd

import sysl.c.{va_arg, va_end, va_start}

// The printf family of `<stdio.h>`: `snprintf`, `sprintf` and their `v`
// twins format into memory; `dprintf`, `printf` and theirs format onto a file descriptor through
// `write`. There is no `FILE` here, so `printf` is `dprintf` to descriptor 1.
//
// A descriptor's output is gathered in a fixed buffer on the stack and handed to `write` each time
// it fills, and once more at the end; memory output goes straight into the caller's buffer. The one
// allocation is a float conversion's specifier (`printf_float.sysl`). A heap that refuses it fails a
// `v` function as POSIX says, -1 with `errno` `ENOMEM`; in the four that take `...` it is a trap.
//
// The conversions are C99's `%d %i %u %o %x %X %c %s %p %n %%`, with the flags `- + space # 0`, a
// width and a precision each written as a number or as `*`, and the lengths `hh h l ll j z t`.
// Where C leaves a choice open, musl's answer is taken, since keel ports programs written against
// musl:
//
// - `%p` is `%#zx`: `0x` and the address in lowercase hex, and a null pointer is `0`.
// - `%s` of a null pointer is `(null)`, and so is `%ls` of one.
// - A conversion C does not define is copied out as it was written, `%` and all.
//
// `%ls` and `%lc` convert wide characters as `wctomb` does in the C locale (`multibyte.sysl`), and
// a precision on `%ls` counts bytes and never ends inside a character. A wide character the locale
// cannot encode fails the call: -1 with `errno` `EILSEQ`. So does a count past `INT_MAX`, with
// `EOVERFLOW`, which C's `int` answer cannot hold; nothing past that point is written.
//
// The float conversions `%f %F %e %E %g %G %a %A` are in `printf_float.sysl`.

@needs(os)
private extern "write" c_write(fd: i32, bytes: *u8, n: usize) -> isize

// How many bytes a descriptor's output gathers before it is handed to `write`.
private const STAGE: usize = 256

// C's `INT_MAX`: the largest count the family can answer.
private const COUNT_MAX: usize = 2147483647

// Where formatted bytes go, and how many the format has produced.
//
// To memory, `dst` is the caller's buffer and `room` its size: a byte is stored only while one
// place is left for the NUL, and `total` goes on counting past that, which is what `snprintf`
// answers. To a descriptor, the bytes gather in `stage`. Which of the two is `to_fd`, never the
// descriptor's value: a negative one is still a descriptor, which `write` refuses.
private[cstd] struct Sink
    dst: *u8
    room: usize
    to_fd: bool
    fd: i32
    total: usize
    stage: [STAGE]u8
    staged: usize
    broken: bool
    // The format failed (`EILSEQ`, `EOVERFLOW`) and `errno` says why: no more bytes are taken.
    refused: bool

    invariant staged <= STAGE
    invariant total <= COUNT_MAX

    memory(dst: *u8, room: usize) -> Sink
        var s: Sink
        s.dst = dst
        s.room = room
        s

    descriptor(fd: i32) -> Sink
        var s: Sink
        s.to_fd = true
        s.fd = fd
        s

    refuse(*self, code: i32)
        errno = code
        self.refused = true

    flush(*self)
        var done: usize = 0
        while done < self.staged && !self.broken
            val wrote = c_write(self.fd, &self.stage[done], self.staged - done)
            if wrote <= 0 then self.broken = true else done += usize(wrote)
        self.staged = 0

    put(*self, b: u8)
        if self.refused then return
        if self.total == COUNT_MAX then return self.refuse(EOVERFLOW)
        if self.to_fd
            self.stage[self.staged] = b
            self.staged += 1
            if self.staged == STAGE then self.flush()
        elif self.total + 1 < self.room
            self.dst[self.total] = b
        self.total += 1
    end put

    // `n` copies of `b`, refused whole when they would take the count past `COUNT_MAX`. To memory,
    // the copies past the caller's buffer are only counted, so a field as wide as `INT_MAX` costs
    // no time.
    put_run(*self, b: u8, n: usize)
        if self.refused then return
        if n > COUNT_MAX - self.total then return self.refuse(EOVERFLOW)
        if self.to_fd
            for _ in 0..<n do self.put(b)
            return
        val left = if self.total + 1 < self.room then self.room - 1 - self.total else 0
        for i in 0..<n.min(left) do self.dst[self.total + i] = b
        self.total += n
    end put_run

    // Pads a field of `body` bytes out to the width, on the side the `-` flag says.
    pad_before(*self, sp: Spec, body: usize)
        if !sp.minus && sp.width > body then self.put_run(' ', sp.width - body)

    pad_after(*self, sp: Spec, body: usize)
        if sp.minus && sp.width > body then self.put_run(' ', sp.width - body)

    // The count a function of this family answers, which C says is an `int`; `put` keeps it in
    // range.
    answer(self) -> i32 = if self.broken || self.refused then -1 else i32(self.total)
end Sink

// What the length modifier said the argument is.
private[cstd] enum Length
    Plain
    Char      // hh
    Short     // h
    Lng       // l
    LngLng    // ll
    Max       // j
    Size      // z
    Diff      // t

// One conversion specification, read.
private[cstd] struct Spec
    minus: bool
    plus: bool
    space: bool
    alt: bool
    zero: bool
    width: usize
    has_precision: bool
    precision: usize
    length: Length
    conv: u8

// A signed argument at the width the length names, narrowed as C converts it.
private signed_arg(ap: *va_list, length: Length) -> i64 = length match
    Lng -> va_arg[Long](*ap)
    LngLng -> va_arg[LongLong](*ap)
    Max -> va_arg[i64](*ap)
    Size | Diff -> va_arg[isize](*ap)
    Char -> i8.wrap(va_arg[i32](*ap))
    Short -> i16.wrap(va_arg[i32](*ap))
    Plain -> va_arg[i32](*ap)

private unsigned_arg(ap: *va_list, length: Length) -> u64 = length match
    Lng -> va_arg[ULong](*ap)
    LngLng -> va_arg[ULongLong](*ap)
    Max -> va_arg[u64](*ap)
    Size -> va_arg[usize](*ap)
    Diff -> u64.wrap(va_arg[isize](*ap))
    Char -> u8.wrap(va_arg[u32](*ap))
    Short -> u16.wrap(va_arg[u32](*ap))
    Plain -> va_arg[u32](*ap)

// `%n`: the count so far, stored at the width the length names.
private store_count(ap: *va_list, length: Length, count: usize) = length match
    Char -> *va_arg[*i8](*ap) = i8.wrap(count)
    Short -> *va_arg[*i16](*ap) = i16.wrap(count)
    Lng -> *va_arg[*Long](*ap) = Long(count)
    LngLng | Max -> *va_arg[*i64](*ap) = i64(count)
    Size | Diff -> *va_arg[*isize](*ap) = isize(count)
    Plain -> *va_arg[*i32](*ap) = i32(count)

// An integer conversion: the sign or `0x`, the zeros the precision or the `0` flag asks for, then
// the digits. A precision of 0 over the value 0 is no digits at all.
private emit_int(s: *Sink, sp: Spec, magnitude: u64, negative: bool)
    val base: u64 = sp.conv match
        'o' -> 8
        'x' | 'X' -> 16
        _ -> 10
    val letters = if sp.conv == 'X' then "0123456789ABCDEF" else "0123456789abcdef"
    var digits: [24]u8
    var n: usize = 0
    var v = magnitude
    while v != 0
        digits[n] = letters[v % base]
        n += 1
        v /= base

    val precision = if sp.has_precision then sp.precision else 1
    var zeros = if precision > n then precision - n else 0
    // `#` with `o` makes the first digit a 0, raising the precision only as far as that takes.
    if sp.alt && sp.conv == 'o' && zeros == 0 then zeros = 1

    val signed = sp.conv == 'd' || sp.conv == 'i'
    val sign: u8 = if negative then '-' elif signed && sp.plus then '+' elif signed && sp.space then ' ' else 0
    val hex_prefix = sp.alt && magnitude != 0 && (sp.conv == 'x' || sp.conv == 'X')

    var body = zeros + n
    if sign != 0 then body += 1
    if hex_prefix then body += 2
    if sp.zero && !sp.minus && !sp.has_precision && sp.width > body
        zeros += sp.width - body
        body = sp.width

    s.pad_before(sp, body)
    if sign != 0 then s.put(sign)
    if hex_prefix
        s.put('0')
        s.put(sp.conv)
    s.put_run('0', zeros)
    while n > 0
        n -= 1
        s.put(digits[n])
    s.pad_after(sp, body)
end emit_int

// `%s`: at most `precision` bytes, and no byte past them is read, so an array with no NUL is fine
// under a precision that stops inside it.
private emit_text(s: *Sink, sp: Spec, text: *u8)
    var n: usize = 0
    while (!sp.has_precision || n < sp.precision) && text[n] != 0 do n += 1
    s.pad_before(sp, n)
    for i in 0..<n do s.put(text[i])
    s.pad_after(sp, n)

private emit_char(s: *Sink, sp: Spec, c: u8)
    s.pad_before(sp, 1)
    s.put(c)
    s.pad_after(sp, 1)

// The most bytes `wctomb` writes for one wide character in any locale cstd could have.
private const MB_BYTES: usize = 4

// `%ls`: the wide characters up to the NUL, each converted by `wctomb`, as many whole ones as fit in
// `precision` bytes; none past them is read. The field is measured before a byte goes out, so a
// character the locale cannot encode refuses the call with nothing of this field written.
private emit_wide_text(s: *Sink, sp: Spec, text: *u32)
    var mb: [MB_BYTES]u8
    var bytes: usize = 0
    var chars: usize = 0
    while !sp.has_precision || bytes < sp.precision
        val wc = text[chars]
        if wc == 0 then break
        val len = wctomb(&mb[0], wc)
        if len < 0 then return s.refuse(EILSEQ)
        if sp.has_precision && bytes + usize(len) > sp.precision then break
        bytes += usize(len)
        chars += 1
    s.pad_before(sp, bytes)
    for k in 0..<chars
        val len = wctomb(&mb[0], text[k])
        for j in 0..<usize(len) do s.put(mb[j])
    s.pad_after(sp, bytes)
end emit_wide_text

// `%lc`: the one wide character converted by `wctomb`, a NUL included, padded to the width.
private emit_wide_char(s: *Sink, sp: Spec, wc: u32)
    var mb: [MB_BYTES]u8
    val len = wctomb(&mb[0], wc)
    if len < 0 then return s.refuse(EILSEQ)
    s.pad_before(sp, usize(len))
    for j in 0..<usize(len) do s.put(mb[j])
    s.pad_after(sp, usize(len))

// A decimal number at the start of `fmt`, and how many bytes it took.
private read_number(fmt: *u8) -> (usize, usize)
    var value: usize = 0
    var i: usize = 0
    while fmt[i] is '0'..'9'
        value = value * 10 + (fmt[i] - '0')
        i += 1
    (value, i)

// The length modifier at the start of `fmt`, and how many bytes it took.
private read_length(fmt: *u8) -> (Length, usize) = fmt[0] match
    'h' -> if fmt[1] == 'h' then (Char, 2) else (Short, 1)
    'l' -> if fmt[1] == 'l' then (LngLng, 2) else (Lng, 1)
    'j' -> (Max, 1)
    'z' -> (Size, 1)
    't' -> (Diff, 1)
    _ -> (Plain, 0)

// Reads one specification starting just past its `%`, consuming the `*` arguments it names, and
// answers it with how many bytes of the format it took.
private read_spec(fmt: *u8, ap: *va_list) -> (Spec, usize)
    var sp = Spec(false, false, false, false, false, 0, false, 0, Plain, 0)
    var i: usize = 0
    loop
        fmt[i] match
            '-' -> sp.minus = true
            '+' -> sp.plus = true
            ' ' -> sp.space = true
            '#' -> sp.alt = true
            '0' -> sp.zero = true
            _ -> break
        i += 1

    if fmt[i] == '*'
        // A width given as `*` is the next `int` argument, and a negative one is the `-` flag and
        // the width it negates.
        val w = i64(va_arg[i32](*ap))
        if w < 0 then sp.minus = true
        sp.width = usize(w.abs())
        i += 1
    else
        val (width, took) = read_number(&fmt[i])
        sp.width = width
        i += took

    if fmt[i] == '.'
        i += 1
        if fmt[i] == '*'
            // A negative precision is taken as if none had been written.
            val p = va_arg[i32](*ap)
            sp.has_precision = p >= 0
            if p >= 0 then sp.precision = usize(p)
            i += 1
        else
            val (precision, took) = read_number(&fmt[i])
            sp.has_precision = true
            sp.precision = precision
            i += took

    val (length, took) = read_length(&fmt[i])
    sp.length = length
    i += took

    sp.conv = fmt[i]
    (sp, i + 1)
end read_spec

// The one formatter every entry point shares.
private format(s: *Sink, fmt: *u8, ap: *va_list)
    var i: usize = 0
    loop
        val b = fmt[i]
        if b == 0 || s.refused then break
        if b != '%'
            s.put(b)
            i += 1
            continue
        val (sp, used) = read_spec(&fmt[i + 1], ap)
        sp.conv match
            'd' | 'i' ->
                val v = signed_arg(ap, sp.length)
                emit_int(s, sp, if v < 0 then 0 -% u64.wrap(v) else u64(v), v < 0)
            'u' | 'o' | 'x' | 'X' -> emit_int(s, sp, unsigned_arg(ap, sp.length), false)
            'p' ->
                val p: *u8 = va_arg(*ap)
                emit_int(s, sp with { conv = 'x', alt = true }, usize(p), false)
            'c' if sp.length == Lng -> emit_wide_char(s, sp, va_arg[u32](*ap))
            'c' -> emit_char(s, sp, u8.wrap(va_arg[i32](*ap)))
            's' if sp.length == Lng ->
                val text: *u32 = va_arg(*ap)
                if text == null then emit_text(s, sp, c"(null)") else emit_wide_text(s, sp, text)
            's' ->
                val text: *u8 = va_arg(*ap)
                emit_text(s, sp, if text == null then c"(null)" else text)
            'n' -> store_count(ap, sp.length, s.total)
            '%' -> s.put('%')
            'f' | 'F' | 'e' | 'E' | 'g' | 'G' | 'a' | 'A' -> emit_float(s, sp, va_arg[real](*ap))
            _ ->
                // Not a conversion C defines: copied out as written. A format ending inside one
                // stops at its NUL.
                for k in 0..used
                    if fmt[i + k] == 0 then return
                    s.put(fmt[i + k])
        i += 1 + used
end format

private to_memory(dst: *u8, room: usize, fmt: *u8, ap: *va_list) -> i32
    var s = Sink.memory(dst, room)
    format(&s, fmt, ap)
    if room > 0 then dst[s.total.min(room - 1)] = 0
    s.answer()

private to_fd(fd: i32, fmt: *u8, ap: *va_list) -> i32
    var s = Sink.descriptor(fd)
    format(&s, fmt, ap)
    s.flush()
    s.answer()

// `vsprintf` and `sprintf` trust the caller's buffer to be big enough, as C does.
private const UNBOUNDED = usize::Max

// What a `v` function answers when the heap refuses a float conversion its specifier.
@no_alloc
private out_of_memory() -> i32
    errno = ENOMEM
    -1

@export("vsnprintf")
@out_of_memory(out_of_memory())
vsnprintf(dst: *u8, n: usize, fmt: *u8, ap: va_list) -> i32 = to_memory(dst, n, fmt, &ap)

@export("vsprintf")
@out_of_memory(out_of_memory())
vsprintf(dst: *u8, fmt: *u8, ap: va_list) -> i32 = to_memory(dst, UNBOUNDED, fmt, &ap)

@export("vdprintf")
@out_of_memory(out_of_memory())
vdprintf(fd: i32, fmt: *u8, ap: va_list) -> i32 = to_fd(fd, fmt, &ap)

@export("vprintf")
@out_of_memory(out_of_memory())
vprintf(fmt: *u8, ap: va_list) -> i32 = to_fd(1, fmt, &ap)

@export("snprintf")
snprintf(dst: *u8, n: usize, fmt: *u8, ...) -> i32
    var ap: va_list
    va_start(ap)
    defer va_end(ap)
    to_memory(dst, n, fmt, &ap)

@export("sprintf")
sprintf(dst: *u8, fmt: *u8, ...) -> i32
    var ap: va_list
    va_start(ap)
    defer va_end(ap)
    to_memory(dst, UNBOUNDED, fmt, &ap)

@export("dprintf")
dprintf(fd: i32, fmt: *u8, ...) -> i32
    var ap: va_list
    va_start(ap)
    defer va_end(ap)
    to_fd(fd, fmt, &ap)

@export("printf")
printf(fmt: *u8, ...) -> i32
    var ap: va_list
    va_start(ap)
    defer va_end(ap)
    to_fd(1, fmt, &ap)
