module sh.sysl.cstd

import sysl.raw.ptr_cast

// The allocator behind `malloc`, with the system call left out.
//
// A heap is one contiguous run of memory, `[start, top)`, that only ever grows at `top`. Where the
// memory comes from is the platform's business — `brk` on Linux's ABI, an array in a test — so
// nothing here asks for any. When no free block fits, `alloc` answers null and `shortfall` says how
// far `top` has to move; the platform moves it and hands the new end to `grow`, which turns the
// added bytes into a free block.
//
// Every block starts with a 16-byte header: its size in bytes, header included, with the low bit
// set while it is in use, and, while it is free, the address of the next free block. The payload
// follows the header, so with every block a multiple of 16 long and the heap starting on a 16-byte
// boundary, every payload is 16-byte aligned, which is what C asks of `malloc` on a 64-bit machine.
//
// The free blocks are a list kept in address order, so a freed block is merged at once with a free
// neighbour on either side: two adjacent free blocks never exist, and freeing everything leaves one
// block. That ordering is what makes `free` linear in the number of free blocks rather than constant;
// a simple, correct allocator is what this is. Nothing here is thread-safe.

// The header, and the alignment every block and payload keeps.
const HEAP_ALIGN: usize = 16

// The smallest block: a header and room for one more header's worth, so that a block split off
// another can itself be freed and listed.
private const MIN_BLOCK: usize = 32

private const IN_USE: usize = 1

private word(at: usize) -> *usize = ptr_cast(at)

private size_of_block(b: usize) -> usize = *word(b) & ~IN_USE

private used(b: usize) -> bool = (*word(b) & IN_USE) != 0

private next_free(b: usize) -> usize = word(b)[1]

private set_next(b: usize, next: usize)
    word(b)[1] = next

private mark(b: usize, size: usize, in_use: bool)
    *word(b) = if in_use then size | IN_USE else size

private round_up(n: usize, to: usize) -> usize = (n + to - 1) & ~(to - 1)

// The block a request of `n` bytes needs, header included, or 0 when the arithmetic would overflow.
private block_for(n: usize) -> usize
    if n > usize::Max - 2 * HEAP_ALIGN then return 0
    val b = round_up(n + HEAP_ALIGN, HEAP_ALIGN)
    if b < MIN_BLOCK then MIN_BLOCK else b

// One heap: the memory it has, `[start, top)`, and the first free block, 0 when there is none.
struct Heap
    start: usize
    top: usize
    free: usize

    // A payload of at least `n` bytes, 16-byte aligned, or null when no free block is big enough
    // (or `n` is too large to be a block at all). The first block that fits is taken, and what is
    // left of it past the request goes back on the list when it is big enough to be a block.
    alloc(*self, n: usize) -> *u8
        val need = block_for(n)
        if need == 0 then return null
        var prev: usize = 0
        var b = self.free
        while b != 0
            val size = size_of_block(b)
            if size >= need
                var rest = next_free(b)
                if size - need >= MIN_BLOCK
                    val tail = b + need
                    mark(tail, size - need, false)
                    set_next(tail, rest)
                    rest = tail
                    mark(b, need, true)
                else
                    mark(b, size, true)
                if prev == 0 then self.free = rest else set_next(prev, rest)
                return ptr_cast(b + HEAP_ALIGN)
            prev = b
            b = next_free(b)
        null
    end alloc

    // How far `top` has to move before `alloc(n)` can succeed: the whole block, less whatever free
    // block already touches `top` and would be merged with the new bytes. 0 when `n` cannot be a
    // block at all, so a caller asks for nothing.
    shortfall(self, n: usize) -> usize
        val need = block_for(n)
        if need == 0 then return 0
        val last = self.free_at_top()
        if last == 0 then need else need - size_of_block(last)

    // The free block that ends at `top`, or 0.
    private free_at_top(self) -> usize
        var b = self.free
        while b != 0
            if b + size_of_block(b) == self.top then return b
            b = next_free(b)
        0

    // The heap's memory now ends at `to`, which is past `top` and 16-byte aligned; the bytes in
    // between become a free block, merged with the free block before them if there is one. The
    // first call sets where the heap starts: `top` 0 means it has no memory yet, and `from` is where
    // the new memory begins.
    grow(*self, from: usize, to: usize)
        if self.top == 0
            self.start = from
            self.top = from
        val at = self.top
        self.top = to
        mark(at, to - at, false)
        self.give_back(at)

    // Puts the free block `b` on the list in address order, merged with a free neighbour on either
    // side.
    private give_back(*self, b: usize)
        var prev: usize = 0
        var next = self.free
        while next != 0 && next < b
            prev = next
            next = next_free(next)
        set_next(b, next)
        if next != 0 && b + size_of_block(b) == next
            mark(b, size_of_block(b) + size_of_block(next), false)
            set_next(b, next_free(next))
        if prev == 0
            self.free = b
        elif prev + size_of_block(prev) == b
            mark(prev, size_of_block(prev) + size_of_block(b), false)
            set_next(prev, next_free(b))
        else
            set_next(prev, b)
    end give_back

    // Frees the payload `p`, which `alloc` answered. A null `p` is nothing to free.
    release(*self, p: *u8)
        if p == null then return
        val b = usize(p) - HEAP_ALIGN
        mark(b, size_of_block(b), false)
        self.give_back(b)

    // Makes the block under `p` hold `n` bytes where it stands, and answers whether it could: a
    // shrink always can (the cut-off tail is freed when it is big enough to be a block), a growth
    // when the block that follows is free and big enough, its unneeded part staying free.
    resize(*self, p: *u8, n: usize) -> bool
        val need = block_for(n)
        if need == 0 then return false
        val b = usize(p) - HEAP_ALIGN
        val size = size_of_block(b)
        if need <= size
            if size - need >= MIN_BLOCK
                mark(b, need, true)
                val tail = b + need
                mark(tail, size - need, false)
                self.give_back(tail)
            return true
        val after = b + size
        if after >= self.top || used(after) then return false
        val joined = size + size_of_block(after)
        if joined < need then return false
        self.unlist(after)
        if joined - need >= MIN_BLOCK
            mark(b, need, true)
            val tail = b + need
            mark(tail, joined - need, false)
            self.give_back(tail)
        else
            mark(b, joined, true)
        true
    end resize

    // How far `top` has to move before `resize(p, n)` can succeed in place: nonzero only for the
    // block nearest `top` — the last one, or the one followed by nothing but the free block that
    // touches `top`.
    resize_shortfall(self, p: *u8, n: usize) -> usize
        val need = block_for(n)
        if need == 0 then return 0
        val b = usize(p) - HEAP_ALIGN
        val size = size_of_block(b)
        if need <= size then return 0
        val after = b + size
        if after == self.top then return need - size
        if used(after) || after + size_of_block(after) != self.top then return 0
        val joined = size + size_of_block(after)
        if joined >= need then 0 else need - joined

    // Takes the free block `b` off the list.
    private unlist(*self, b: usize)
        if self.free == b
            self.free = next_free(b)
            return
        var prev = self.free
        while next_free(prev) != b
            prev = next_free(prev)
        set_next(prev, next_free(b))

    // How many bytes the payload `p` can hold: its block, less the header.
    usable(self, p: *u8) -> usize = size_of_block(usize(p) - HEAP_ALIGN) - HEAP_ALIGN

    // How many blocks are on the free list, and how many bytes they hold together, headers included.
    free_blocks(self) -> usize
        var n: usize = 0
        var b = self.free
        while b != 0
            n += 1
            b = next_free(b)
        n

    free_bytes(self) -> usize
        var n: usize = 0
        var b = self.free
        while b != 0
            n += size_of_block(b)
            b = next_free(b)
        n
end Heap
