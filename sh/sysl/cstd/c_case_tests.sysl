module sh.sysl.cstd

@tests

// The harness every cstd test goes through: a C snippet, compiled against `include/` and the
// archive `sysl build-c` writes, run, and its standard output compared byte for byte with what the
// test says it should be.
//
// **The expected output is written in the test, never asked of the host's libc.** A case that
// compared against Apple's `strtol` would inherit every choice Apple made where C leaves one open,
// and would pass for the wrong reason wherever the two libraries were wrong together.
//
// The snippet is the body of `main`; an optional prelude is the C that goes above it, for what a
// function body cannot hold (a comparator for `qsort`). It reports through the `say_*` printers in `tests/say.h`,
// which reach the host for nothing but `write`. It is compiled `-fno-builtin -O0`: clang folds
// `strlen("hello")` to 5 otherwise, and the call that was meant to be tested is never made.

// **The same cases run under AddressSanitizer** with the command the org runs every package under,
// `SYSL_EXTRA_CFLAGS="-fsanitize=address -g" sysl test .`: the variable reaches the `sysl build-c`
// below through the environment, and `c_case` hands the same flags to the clang that builds each
// case, so the archive and every program linked against it are instrumented together.

import sysl.buf.{Buf, buf}
import sysl.env.get_or
import sysl.fs.{make_dir, make_dir_all, read_text, remove_dir, remove_file, write_text}
import sysl.posix.time.sleep
import sysl.process.{Output, capture}
import sysl.testing.{compiler, skip}
import sysl.text.{Search, split}
import sysl.time.millis

private extern "getppid" c_ppid() -> i32
private extern "getpid" c_pid() -> i32

// Where the archive and every case's program are written. It is under `.sysl/`, which git ignores.
private val work: string = ".sysl/c-tests"

// How many cases this process has run, so two in one test do not share a file name.
private var cases: int = 0

private stamp_says(stamp: string, run: string) -> bool = read_text(stamp) match
    Ok(text) -> text == run
    Err(_) -> false

private fail_with(what: string, out: string) -> never = panic(f"$what:\n$out")

/** The archive under test, built **once per run of the suite** rather than once per case.
 *
 * `sysl test` runs each test in a process of its own, so nothing in this process's memory outlives
 * the test. What every test of one run shares is the runner, which is each one's parent: the
 * runner's pid, written beside the archive once it is built, says whether the archive on disk is
 * this run's. A lock directory named for the run makes concurrent tests wait for one build, and a
 * run that was killed holding its lock leaves a name no later run will ask for.
 */
private[cstd] archive() -> string
    val run = f"${c_ppid()}"
    val stamp = f"$work/built-by"
    val lib = f"$work/libcstd.a"
    if stamp_says(stamp, run) then return lib

    make_dir_all(work).unwrap()
    val lock = f"$work/lock-$run"
    loop
        if make_dir(lock).is_ok() then break
        sleep(millis(50))

    if !stamp_says(stamp, run)
        val built = capture(compiler(), ["build-c", ".", "-o", lib], stderr = true).unwrap()
        if !built.status.ok()
            _ = remove_dir(lock)
            fail_with("sysl build-c failed", built.err.unwrap_or(""))
        val res = capture("clang", ["-print-resource-dir"]).unwrap()
        write_text(f"$work/resource-dir", res.text.trim()).unwrap()
        write_text(stamp, run).unwrap()

    _ = remove_dir(lock)
    lib
end archive

/** Compile `snippet` as the body of `int main(void)`, run it, and answer what it printed and how it
 * ended.
 *
 * The program is built the way the README tells a consumer to build one — `-nostdinc`, clang's own
 * freestanding headers, then `include/` — so a case cannot reach a host header by accident, and a
 * declaration cstd's headers get wrong is a compile error here.
 */
private[cstd] c_run(snippet: string, prelude: string = "", asan: bool = false) -> Output
    val lib = archive()
    val res = read_text(f"$work/resource-dir").unwrap()
    cases += 1
    val name = f"$work/case-${c_pid()}-$cases"
    val source = f"#include \"say.h\"\n\n$prelude\n\nint main(void) {\n$snippet\n    return 0;\n}\n"
    write_text(f"$name.c", source).unwrap()

    var args: Buf[string] = buf()
    for a in ["-std=c11", "-O0", "-fno-builtin", "-nostdinc", "-isystem", f"$res/include",
              "-I", "include", "-I", "tests", f"$name.c", lib, "-o", name]
        args.push(a)
    for flag in extra_cflags() do args.push(flag)
    if asan then args.push("-fsanitize=address")
#if macos
    // macOS AddressSanitizer checks at startup that its `puts` interceptor is installed by looking
    // `puts` up by name across the process, and aborts ("interceptors not installed") when the
    // answer is not its own wrapper. A program linked with cstd exports cstd's `puts`, which that
    // lookup finds first, so the case's program keeps it out of its export table; the program's own
    // calls still reach cstd's `puts`.
    args.push("-Wl,-unexported_symbol,_puts")
#endif

    val compiled = capture("clang", args.view(), stderr = true).unwrap()
    if !compiled.status.ok() then fail_with(f"clang refused the case:\n$source", compiled.err.unwrap_or(""))

    val ran = capture(name, timeout = 10000, stderr = true).unwrap()
    _ = remove_file(f"$name.c")
    _ = remove_file(name)
    ran
end c_run

// `c_run`, and the check that the program exited 0 having printed exactly `expected`.
private[cstd] c_case(snippet: string, expected: string, prelude: string = "")
    val ran = c_run(snippet, prelude)
    if !ran.status.ok()
        val err = ran.err.unwrap_or("")
        fail_with(f"the case did not exit 0 (${ran.status})", f"${ran.text}$err")
    assert_eq(ran.text, expected)

// The words of `SYSL_EXTRA_CFLAGS`, which is what the compiler splices into every clang it drives.
private extra_cflags() -> Buf[string]
    var flags: Buf[string] = buf()
    for word in split(get_or("SYSL_EXTRA_CFLAGS", ""), " ")
        if word != "" then flags.push(word)
    flags

// A green run under ASan means nothing unless cstd's own functions were instrumented: the runtime
// alone brings `__asan_init`, and only an instrumented function calls a `__asan_report_*`.
@test("under -fsanitize=address, the archive's functions are instrumented")
asan_instruments_the_archive()
    if !get_or("SYSL_EXTRA_CFLAGS", "").contains("-fsanitize=address")
        skip("SYSL_EXTRA_CFLAGS does not ask for AddressSanitizer")
    val undefined = capture("nm", ["-u", archive()]).unwrap()
    assert(undefined.status.ok())
    assert(undefined.text.contains("___asan_report_load1"))
    assert(undefined.text.contains("___asan_report_store1"))

// And the instrumentation has to be able to say no: `strlen` over a buffer with no NUL in it reads
// past the end inside cstd, and ASan names the function.
@test("under -fsanitize=address, an over-read inside cstd's strlen is reported")
asan_reports_an_over_read()
    if !get_or("SYSL_EXTRA_CFLAGS", "").contains("-fsanitize=address")
        skip("SYSL_EXTRA_CFLAGS does not ask for AddressSanitizer")
    val ran = c_run(raw"""
        char b[3] = {1, 2, 3};
        say_uint(strlen(b));
        """)
    val report = ran.err.unwrap_or("")
    assert(!ran.status.ok())
    assert(report.contains("AddressSanitizer: stack-buffer-overflow"))
    // The exported `strlen` and the module's own name are one address; the symbolizer may print
    // either.
    assert(report.contains(" in strlen") || report.contains(" in sh.sysl.cstd$strlen"))

// Every ordinary run builds one case under AddressSanitizer too, so an export that stops an ASan
// program from starting (cstd's `puts`, on macOS) is caught without the ASan suite. The archive need
// not be instrumented for that: the runtime's startup checks are about what the program exports.
// The line order says whose `puts` ran: cstd's writes at once, a libc's would sit in a stdio buffer
// until exit, after the `write` of `say_int`.
@test("a case linked under -fsanitize=address starts, and its puts is cstd's")
asan_case_starts()
    make_dir_all(work).unwrap()
    val probe = f"$work/asan-probe-${c_pid()}"
    write_text(f"$probe.c", "int main(void) { return 0; }\n").unwrap()
    val tried = capture("clang", ["-fsanitize=address", f"$probe.c", "-o", probe], stderr = true).unwrap()
    _ = remove_file(f"$probe.c")
    _ = remove_file(probe)
    if !tried.status.ok() then skip("clang has no AddressSanitizer runtime for this host")
    val ran = c_run(raw"""
        int r = puts("hello");
        say_int(r >= 0);
        """, asan = true)
    if !ran.status.ok() then fail_with(f"the ASan case did not exit 0 (${ran.status})", ran.err.unwrap_or(""))
    assert_eq(ran.text, "hello\n1\n")
