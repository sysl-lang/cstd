module sh.sysl.cstd

// `<ctype.h>` for the C locale, which is the only locale this library has (`locale.sysl`).
//
// C hands each of these an `int` that is either `EOF` (-1) or a byte read as `unsigned char`, and
// in the C locale only the ASCII bytes belong to any class: every byte from 0x80 up answers no to
// every question and is its own upper and lower case. A true answer is 1; C promises only
// "nonzero", and a caller that compares with `== 1` is relying on this library rather than on C.
//
// As in `string.sysl`, every function is exported under its C name.

private between(c: i32, lo: char, hi: char) -> bool = c >= i32(lo) && c <= i32(hi)

private answer(yes: bool) -> i32 = if yes then 1 else 0

@export("isdigit")
isdigit(c: i32) -> i32 = answer(between(c, '0', '9'))

@export("isupper")
isupper(c: i32) -> i32 = answer(between(c, 'A', 'Z'))

@export("islower")
islower(c: i32) -> i32 = answer(between(c, 'a', 'z'))

@export("isalpha")
isalpha(c: i32) -> i32 = answer(between(c, 'A', 'Z') || between(c, 'a', 'z'))

@export("isalnum")
isalnum(c: i32) -> i32 = answer(isalpha(c) != 0 || isdigit(c) != 0)

@export("isxdigit")
isxdigit(c: i32) -> i32 =
    answer(between(c, '0', '9') || between(c, 'a', 'f') || between(c, 'A', 'F'))

// Space, `\t`, `\n`, `\v`, `\f` and `\r`: the space and the run 9 to 13.
@export("isspace")
isspace(c: i32) -> i32 = answer(c == i32(' ') || (c >= 9 && c <= 13))

@export("isblank")
isblank(c: i32) -> i32 = answer(c == i32(' ') || c == i32('\t'))

@export("iscntrl")
iscntrl(c: i32) -> i32 = answer((c >= 0 && c < 32) || c == 127)

// Every visible character: the printable ones less the space.
@export("isgraph")
isgraph(c: i32) -> i32 = answer(between(c, '!', '~'))

@export("isprint")
isprint(c: i32) -> i32 = answer(between(c, ' ', '~'))

@export("ispunct")
ispunct(c: i32) -> i32 = answer(isgraph(c) != 0 && isalnum(c) == 0)

@export("tolower")
tolower(c: i32) -> i32 = if isupper(c) != 0 then c + 32 else c

@export("toupper")
toupper(c: i32) -> i32 = if islower(c) != 0 then c - 32 else c

// The `_l` variants ask the same questions of a given locale. Every locale is the C locale here
// (`locale.sysl`), so each answers exactly as its plain twin, whatever `loc` it is handed.

@export("isalnum_l")
isalnum_l(c: i32, loc: *u8) -> i32 = isalnum(c)

@export("isalpha_l")
isalpha_l(c: i32, loc: *u8) -> i32 = isalpha(c)

@export("isblank_l")
isblank_l(c: i32, loc: *u8) -> i32 = isblank(c)

@export("iscntrl_l")
iscntrl_l(c: i32, loc: *u8) -> i32 = iscntrl(c)

@export("isdigit_l")
isdigit_l(c: i32, loc: *u8) -> i32 = isdigit(c)

@export("isgraph_l")
isgraph_l(c: i32, loc: *u8) -> i32 = isgraph(c)

@export("islower_l")
islower_l(c: i32, loc: *u8) -> i32 = islower(c)

@export("isprint_l")
isprint_l(c: i32, loc: *u8) -> i32 = isprint(c)

@export("ispunct_l")
ispunct_l(c: i32, loc: *u8) -> i32 = ispunct(c)

@export("isspace_l")
isspace_l(c: i32, loc: *u8) -> i32 = isspace(c)

@export("isupper_l")
isupper_l(c: i32, loc: *u8) -> i32 = isupper(c)

@export("isxdigit_l")
isxdigit_l(c: i32, loc: *u8) -> i32 = isxdigit(c)

@export("tolower_l")
tolower_l(c: i32, loc: *u8) -> i32 = tolower(c)

@export("toupper_l")
toupper_l(c: i32, loc: *u8) -> i32 = toupper(c)
