module sh.sysl.cstd

import sysl.fmt.{float_scratch_len, write_real}
import sysl.text.from_utf8_unchecked

// The float conversions of the printf family: `%f %F %e %E %g %G %a %A`.
//
// **The digits are the standard library's.** `sysl.fmt.write_real` prints a double under a printf
// conversion -- every digit the exact value's, rounded half to even, with C's flags, width and
// precision -- in integer arithmetic, into scratch the caller lends and straight into a `Writer`.
// All that is left here is to say the conversion the way `write_real` reads it and to give it the
// sink: the specifier is rebuilt from the parsed `Spec` (flags and the conversion letter, the
// width and the precision passed as numbers), and `Sink` is the `Writer`.
//
// `L` (`long double`) is not taken: cstd has no `long double`, so `%Lf` is a conversion it does
// not define and is copied out as written, its argument left unread.

impl Fallible for Sink
    override failed(*self) -> bool = self.broken

impl Writer for Sink
    write(*self, bytes: []const u8)
        for b in bytes do put(self, b)

// The specifier `write_real` is handed for `sp`: `%`, the flags, a `*` for the width,
// `.*` where there is a precision, and the conversion letter.
private specifier(sp: Spec, into: *[12]u8) -> usize
    var n: usize = 0
    into[n] = u8('%')
    n += 1
    if sp.minus
        into[n] = u8('-')
        n += 1
    if sp.plus
        into[n] = u8('+')
        n += 1
    if sp.space
        into[n] = u8(' ')
        n += 1
    if sp.alt
        into[n] = u8('#')
        n += 1
    if sp.zero
        into[n] = u8('0')
        n += 1
    into[n] = u8('*')
    n += 1
    if sp.has_precision
        into[n] = u8('.')
        into[n + 1] = u8('*')
        n += 2
    into[n] = sp.conv
    n + 1
end specifier

// One float conversion of `x` under `sp`, with `scratch` to work in. A refusal -- a scratch too short
// for the digits -- is a failed conversion, which the family answers as `-1`.
private[cstd] emit_float_in(s: *Sink, sp: Spec, x: real, scratch: []u8)
    var text: [12]u8
    val n = specifier(sp, &text)
    val precision: int = if sp.has_precision then int(sp.precision) else -1

    write_real(x, s, from_utf8_unchecked(text[0..<n]), int(sp.width), precision, scratch) match
        Ok(_) -> ()
        Err(_) -> s.broken = true
end emit_float_in

// One float conversion of `x` under `sp`. `float_scratch_len` bytes are enough for any double.
private[cstd] emit_float(s: *Sink, sp: Spec, x: real)
    var scratch: [float_scratch_len]u8
    emit_float_in(s, sp, x, scratch[..])
end emit_float
